---
import SiteLayout from '../layouts/SiteLayout.astro';
import { definePage } from '../lib/define-page';
import contactMain from '../partials/contact-main.frag.txt?raw';
import { buildSimpleGraph, serializeGraph } from '../lib/schema/graph';
import { TM_OPS_CONTACT_FORM_LOCATION_SLUGS } from '../lib/contact-routing-policy.mjs';

const ld = serializeGraph(
    buildSimpleGraph([
        { label: 'Home', href: '/' },
        { label: 'Contact', href: '/contact' },
    ]),
);
const page = definePage({ canonicalPath: '/contact' });
---

<SiteLayout
    canonicalPath={page.canonicalPath}
    bodyClass="has-noise"
>
    <Fragment slot="head-extra">
        <meta name="tm-contact-form-only-locations" content={TM_OPS_CONTACT_FORM_LOCATION_SLUGS.join(',')} />
        <link rel="stylesheet" href="/css/page-contact.css?v=5" />
    </Fragment>
    <Fragment slot="json-ld">
        <script type="application/ld+json" is:inline set:html={ld}></script>
    </Fragment>
    <div set:html={contactMain} />
    <Fragment slot="after-site-scripts">
        <script is:inline defer src="/js/page-contact-after.js?v=4"></script>
    </Fragment>
</SiteLayout>
