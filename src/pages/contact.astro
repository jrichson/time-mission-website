---
import SiteLayout from '../layouts/SiteLayout.astro';
import { definePage } from '../lib/define-page';
import contactMainRaw from '../partials/contact-main.frag.txt?raw';
import { buildSimpleGraph, serializeGraph } from '../lib/schema/graph';
import { TM_OPS_CONTACT_FORM_LOCATION_SLUGS } from '../lib/contact-routing-policy.mjs';
import { allLocations } from '../data/locations';
import { locationsForRegion, locationListLabel, orderedLocationRegions } from '../lib/location-list';
import { activeSiteProfile } from '../lib/site-profile';
import { regionalCorporateContactEmail } from '../lib/regional-content';

function escapeHtml(value: string): string {
    return value
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
}

const contactRegionLabels = { us: 'United States', europe: 'Europe' } as const;
const contactLocationOptions = orderedLocationRegions(activeSiteProfile.internalRegion)
    .map((region) => {
        const options = locationsForRegion(allLocations, region)
            .map((location) => (
                `<option value="${escapeHtml(location.slug)}">${escapeHtml(locationListLabel(location))}</option>`
            ))
            .join('');
        return `<optgroup label="${contactRegionLabels[region]}">${options}</optgroup>`;
    })
    .join('');
const generalContactEmail = regionalCorporateContactEmail(activeSiteProfile);
const contactPhonePlaceholder = activeSiteProfile.id === 'eu' ? '+32 470 12 34 56' : '+1 555 123 4567';
const contactMain = contactMainRaw
    .replaceAll('{{CONTACT_LOCATION_OPTIONS}}', contactLocationOptions)
    .replaceAll('{{GENERAL_CONTACT_EMAIL}}', generalContactEmail)
    .replaceAll('{{CONTACT_PHONE_PLACEHOLDER}}', contactPhonePlaceholder);

const ld = serializeGraph(
    buildSimpleGraph([
        { label: 'Home', href: '/' },
        { label: 'Contact', href: '/contact' },
    ]),
);
const page = definePage({ canonicalPath: '/contact' });
---

<SiteLayout
    canonicalPath={page.canonicalPath}
    bodyClass="has-noise"
>
    <Fragment slot="head-extra">
        <meta name="tm-contact-form-only-locations" content={TM_OPS_CONTACT_FORM_LOCATION_SLUGS.join(',')} />
        <link rel="stylesheet" href="/css/page-contact.css?v=5" />
    </Fragment>
    <Fragment slot="json-ld">
        <script type="application/ld+json" is:inline set:html={ld}></script>
    </Fragment>
    <div set:html={contactMain} />
    <Fragment slot="after-site-scripts">
        <script is:inline defer src="/js/page-contact-after.js?v=4"></script>
    </Fragment>
</SiteLayout>
