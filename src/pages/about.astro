---
import SiteLayout from '../layouts/SiteLayout.astro';
import { definePage } from '../lib/define-page';
import aboutMain from '../partials/about-main.frag.txt?raw';
import { buildSimpleGraph, serializeGraph } from '../lib/schema/graph';

const ld = serializeGraph(buildSimpleGraph());
const page = definePage({ canonicalPath: '/about' });
---

<SiteLayout
    canonicalPath={page.canonicalPath}
>
    <Fragment slot="head-extra">
        <link
            rel="preload"
            as="image"
            href="/assets/photos/venue/_Time-Mission_0078-480.webp"
            imagesrcset="/assets/photos/venue/_Time-Mission_0078-480.webp 480w, /assets/photos/venue/_Time-Mission_0078-800.webp 800w, /assets/photos/venue/_Time-Mission_0078-1200.webp 1200w, /assets/photos/venue/_Time-Mission_0078.webp 1920w"
            imagesizes="100vw"
            type="image/webp"
            fetchpriority="high"
        />
        <link rel="stylesheet" href="/css/page-about.css?v=1" />
    </Fragment>
    <Fragment slot="json-ld">
        <script type="application/ld+json" is:inline set:html={ld}></script>
    </Fragment>
    <div set:html={aboutMain} />
    <Fragment slot="after-site-scripts">
        <script defer src="/js/page-about-after.js?v=1"></script>
    </Fragment>
</SiteLayout>
