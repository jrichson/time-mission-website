---
import SiteLayout from '../layouts/SiteLayout.astro';
import { definePage } from '../lib/define-page';
import notFoundMain from '../partials/404-main.frag.txt?raw';

const page = definePage({ canonicalPath: '/404' });
---

<SiteLayout canonicalPath={page.canonicalPath} bodyClass="has-noise">
    <Fragment slot="head-extra">
        <link rel="stylesheet" href="/css/page-404.css?v=1" />
    </Fragment>
    <div set:html={notFoundMain} />
</SiteLayout>
