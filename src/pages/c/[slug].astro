---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { definePage } from '../../lib/define-page';
import {
    getPublishedLandings,
    landingArchetypeForDoc,
    landingCtaForDoc,
    landingCanonicalPath,
    landingDocLooksRenderable,
    landingHeadForDoc,
    landingLaunchStateForDoc,
    landingTemplateLabel,
    type PayloadLandingDoc,
} from '../../lib/payload/load';

export const prerender = true;

export async function getStaticPaths() {
    const raw = await getPublishedLandings();
    const docs = raw.filter((d) => landingDocLooksRenderable(d));
    return docs.map((doc) => ({
        params: { slug: doc.slug },
        props: { doc },
    }));
}

const { doc } = Astro.props as { doc: PayloadLandingDoc };
const page = definePage({ canonicalPath: landingCanonicalPath(doc.slug) });
const landingHead = landingHeadForDoc(doc)!;
const c = doc.content!;
const cta = landingCtaForDoc(doc);
const template = landingArchetypeForDoc(doc);
const launchState = landingLaunchStateForDoc(doc);
const templateLabel = landingTemplateLabel(template);
const heroImage = doc.seo?.ogImage || '/assets/photos/experiences/Time-Mission_Magma_Mayhem-2.jpg';

const bullets = Array.isArray(c.bullets) ? c.bullets.map((b) => String(b?.text || '').trim()).filter(Boolean) : [];
const proofItems = bullets.length
    ? bullets.slice(0, 6)
    : ['25+ interactive mission rooms', 'Team-based scoring', 'Built for every age and group size'];
const strategy = doc.strategy || {};
const paidSocial = doc.paidSocial || {};
const localVenue = doc.localVenue || {};
const groupEvent = doc.groupEvent || {};
const proofIntro =
    strategy.proofAngle ||
    (template === 'group_event'
        ? groupEvent.plannerReassurance || 'Proof that the group experience is easy to plan and worth showing up for.'
        : template === 'local_venue_city'
            ? localVenue.venueConfidence || 'Proof that this is a real venue with a Time Mission experience worth visiting.'
            : paidSocial.frictionReducer || 'Proof that the promise is easy to understand and simple to act on.');
const detailHeading =
    template === 'group_event'
        ? 'A session built for your crew'
        : launchState === 'coming_soon'
            ? 'First in line for the next mission'
            : template === 'local_venue_city'
                ? 'A local reason to book the mission'
                : 'Focused, fast, and easy to act on';
const proofHeading =
    template === 'group_event'
        ? 'Built for groups that want more than a reservation'
        : launchState === 'coming_soon'
            ? 'Get ready before the doors open'
            : template === 'local_venue_city'
                ? 'A venue-first reason to visit'
                : 'Make the first click count';
const detailKicker =
    template === 'group_event'
        ? 'Planner Confidence'
        : launchState === 'coming_soon'
            ? 'Opening Updates'
            : template === 'local_venue_city'
                ? 'Local Campaign'
                : 'Campaign Details';
const finalHeading =
    launchState === 'coming_soon'
        ? 'Want opening updates?'
        : template === 'group_event'
            ? 'Ready to plan the event?'
            : 'Ready to start?';
const finalCopy =
    template === 'group_event'
        ? groupEvent.logisticsNote || 'Bring the crew. We will handle the missions, scoring, and momentum.'
        : launchState === 'coming_soon'
            ? localVenue.openingNote || landingHead.metaDescription
            : landingHead.metaDescription;

const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: landingHead.metaTitle,
    url: page.canonicalPath === '/' ? 'https://timemission.com/' : `https://timemission.com${page.canonicalPath}`,
};
/** Embed-safe JSON-LD: escape `<` so `</script>` in strings cannot terminate the HTML script block. */
const jsonLdEmbed = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<SiteLayout canonicalPath={page.canonicalPath} landingHead={landingHead} bodyClass="tm-landing-body">
    <Fragment slot="head-extra">
        <link rel="stylesheet" href="/css/footer.css?v=3" />
        <link rel="stylesheet" href="/css/ticket-panel.css" />
        <link rel="stylesheet" href="/css/newsletter.css?v=2" />
    </Fragment>
    <Fragment slot="page-style">
        <style is:global>
            body.tm-landing-body {
                --tm-landing-accent: var(--orange, #ff6b2c);
                --tm-landing-black: #050508;
                --tm-landing-panel: #101014;
                --tm-landing-line: rgba(255, 255, 255, 0.14);
            }
            .tm-landing-main {
                color: var(--white, #fff);
                font-family: var(--body, 'DM Sans', sans-serif);
                background: var(--tm-landing-black);
            }
            .tm-landing-hero {
                position: relative;
                min-height: 70vh;
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: hidden;
                padding: clamp(7rem, 12vw, 9rem) 1.5rem clamp(3rem, 7vw, 5rem);
            }
            .tm-landing-shell {
                position: relative;
                z-index: 2;
                width: min(100%, 74rem);
                margin: 0 auto;
            }
            .tm-landing-hero-copy {
                width: min(100%, 48rem);
                margin: 0 auto;
                text-align: center;
            }
            .tm-landing-hero-media {
                position: absolute;
                inset: 0;
                z-index: 0;
            }
            .tm-landing-hero-media::after {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(180deg, rgba(5, 5, 8, 0.38), rgba(5, 5, 8, 0.68) 58%, var(--tm-landing-black));
            }
            .tm-landing-hero-media img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                object-position: center 42%;
                opacity: 0.68;
            }
            .tm-landing-kicker {
                display: inline-flex;
                align-items: center;
                min-height: 2rem;
                padding: 0.35rem 0.75rem;
                border: 1px solid rgba(255, 255, 255, 0.18);
                border-radius: 999px;
                background: rgba(5, 5, 8, 0.62);
                font-size: 0.72rem;
                letter-spacing: 0.14em;
                text-transform: uppercase;
                color: var(--tm-landing-accent);
                font-family: var(--tech, 'Orbitron', sans-serif);
                margin: 0 0 1rem;
            }
            .tm-landing-headline {
                font-family: var(--display, 'Bebas Neue', sans-serif);
                font-size: clamp(3rem, 8vw, 6rem);
                line-height: 0.94;
                margin: 0 0 1rem;
                text-wrap: balance;
            }
            .tm-landing-sub {
                width: min(100%, 42rem);
                font-size: clamp(1rem, 2vw, 1.22rem);
                line-height: 1.65;
                color: rgba(255, 255, 255, 0.78);
                margin: 0 auto 1.75rem;
            }
            .tm-landing-actions,
            .tm-landing-cta-row {
                display: flex;
                flex-wrap: wrap;
                gap: 0.85rem;
                justify-content: center;
            }
            .tm-landing-cta,
            .tm-landing-secondary {
                display: inline-flex;
                min-height: 44px;
                align-items: center;
                justify-content: center;
                border-radius: 999px;
                padding: 0.85rem 1.35rem;
                font-size: 0.9rem;
                font-weight: 700;
                letter-spacing: 0.04em;
                text-transform: uppercase;
                text-decoration: none;
                cursor: pointer;
            }
            .tm-landing-cta {
                background: var(--gradient-primary, linear-gradient(135deg, #ff7a00, #ff3d00));
                color: #fff;
                border: 0;
                box-shadow: 0 0 24px rgba(255, 106, 0, 0.34);
            }
            .tm-landing-secondary {
                color: #fff;
                border: 1px solid rgba(255, 255, 255, 0.24);
                background: rgba(255, 255, 255, 0.04);
            }
            .tm-landing-cta:focus-visible,
            .tm-landing-secondary:focus-visible {
                outline: 2px solid #fff;
                outline-offset: 3px;
            }
            .tm-landing-proof,
            .tm-landing-split,
            .tm-landing-final {
                padding: clamp(3.5rem, 8vw, 6rem) 1.5rem;
            }
            .tm-landing-proof {
                background: var(--tm-landing-black);
            }
            .tm-landing-section-head {
                width: min(100%, 46rem);
                margin: 0 auto 2rem;
                text-align: center;
            }
            .tm-landing-section-head h2,
            .tm-landing-split-copy h2,
            .tm-landing-final h2 {
                font-family: var(--display, 'Bebas Neue', sans-serif);
                font-size: clamp(2.4rem, 5vw, 4rem);
                line-height: 0.98;
                margin: 0 0 0.8rem;
                text-wrap: balance;
            }
            .tm-landing-section-head p,
            .tm-landing-split-copy p,
            .tm-landing-final p {
                color: rgba(255, 255, 255, 0.7);
                line-height: 1.65;
                margin: 0;
            }
            .tm-landing-proof-grid {
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 1rem;
            }
            .tm-landing-proof-card {
                min-height: 11rem;
                border: 1px solid var(--tm-landing-line);
                border-radius: 8px;
                padding: 1.25rem;
                background: rgba(255, 255, 255, 0.04);
            }
            .tm-landing-proof-number {
                display: block;
                margin-bottom: 1rem;
                color: var(--tm-landing-accent);
                font-family: var(--tech, 'Orbitron', sans-serif);
                font-size: 0.75rem;
                letter-spacing: 0.12em;
                text-transform: uppercase;
            }
            .tm-landing-proof-card h3 {
                margin: 0;
                font-size: 1.05rem;
                line-height: 1.35;
            }
            .tm-landing-split {
                background: var(--tm-landing-panel);
            }
            .tm-landing-split-grid {
                display: grid;
                grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
                gap: clamp(1.5rem, 5vw, 4rem);
                align-items: center;
            }
            .tm-landing-split-image {
                aspect-ratio: 4 / 3;
                overflow: hidden;
                border-radius: 8px;
                border: 1px solid var(--tm-landing-line);
            }
            .tm-landing-split-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }
            .tm-landing-bullets {
                list-style: none;
                padding: 0;
                margin: 1.5rem 0 0;
            }
            .tm-landing-bullets li {
                position: relative;
                padding-left: 1.35rem;
                margin-bottom: 0.65rem;
                line-height: 1.45;
                color: rgba(255, 255, 255, 0.82);
            }
            .tm-landing-bullets li::before {
                content: '';
                position: absolute;
                left: 0;
                top: 0.55rem;
                width: 0.45rem;
                height: 0.45rem;
                border-radius: 50%;
                background: var(--tm-landing-accent);
            }
            .tm-landing-final {
                text-align: center;
                background: var(--tm-landing-black);
            }
            .tm-landing-final p {
                margin: 0 auto 1.5rem;
                width: min(100%, 38rem);
            }
            .tm-landing-main--paid_social_campaign .tm-landing-proof-card,
            .tm-landing-main--local_venue_city .tm-landing-proof-card,
            .tm-landing-main--group_event .tm-landing-proof-card {
                min-height: 11rem;
            }
            .tm-landing-main--local_venue_city .tm-landing-proof-card {
                min-height: 8rem;
            }
            .tm-landing-main--local_venue_city .tm-landing-kicker {
                color: #ffd0b8;
            }
            @media (max-width: 840px) {
                .tm-landing-proof-grid,
                .tm-landing-split-grid {
                    grid-template-columns: 1fr;
                }
                .tm-landing-hero {
                    min-height: 62vh;
                }
                .tm-landing-headline {
                    font-size: clamp(2.75rem, 14vw, 4.4rem);
                }
            }
        </style>
    </Fragment>
    <Fragment slot="json-ld">
        <script type="application/ld+json" is:inline set:html={jsonLdEmbed} />
    </Fragment>

    <main class:list={['tm-landing-main', `tm-landing-main--${template}`]} id="main">
        <section class="tm-landing-hero">
            <div class="tm-landing-hero-media" aria-hidden="true">
                <img src={heroImage} alt="" width="1920" height="1280" loading="eager" decoding="async" />
            </div>
            <div class="tm-landing-shell">
                <div class="tm-landing-hero-copy">
                    <p class="tm-landing-kicker">{templateLabel}</p>
                    <h1 class="tm-landing-headline">{c.headline}</h1>
                    {c.subheadline ? <p class="tm-landing-sub">{c.subheadline}</p> : null}
                    <div class="tm-landing-actions">
                        {
                            cta.bookTrigger ? (
                                <button
                                    type="button"
                                    class="tm-landing-cta"
                                    data-tm-booking-trigger
                                    data-tm-landing-primary
                                    data-link-path={cta.linkPath}
                                    data-cta-surface={cta.surface}
                                >
                                    {c.primaryCtaLabel}
                                </button>
                            ) : (
                                <a
                                    href={cta.primaryHref}
                                    class="tm-landing-cta"
                                    data-tm-landing-primary
                                    data-link-path={cta.linkPath}
                                    data-cta-surface={cta.surface}
                                    {...cta.surface === 'external' ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
                                >
                                    {c.primaryCtaLabel}
                                </a>
                            )
                        }
                        {
                            template === 'group_event' ? (
                                <a class="tm-landing-secondary" href="/groups">Explore events</a>
                            ) : template === 'local_venue_city' ? (
                                <a class="tm-landing-secondary" href="/locations">View locations</a>
                            ) : null
                        }
                    </div>
                </div>
            </div>
        </section>

        <section class="tm-landing-proof">
            <div class="tm-landing-shell">
                <div class="tm-landing-section-head">
                    <p class="tm-landing-kicker">Why Time Mission</p>
                    <h2>
                        {proofHeading}
                    </h2>
                    <p>{proofIntro}</p>
                </div>
                <div class="tm-landing-proof-grid">
                    {
                        proofItems.slice(0, 3).map((item, index) => (
                            <article class="tm-landing-proof-card">
                                <span class="tm-landing-proof-number">Proof {String(index + 1).padStart(2, '0')}</span>
                                <h3>{item}</h3>
                            </article>
                        ))
                    }
                </div>
            </div>
        </section>

        <section class="tm-landing-split">
            <div class="tm-landing-shell tm-landing-split-grid">
                <div class="tm-landing-split-image">
                    <img src={heroImage} alt="" width="1400" height="1050" loading="lazy" decoding="async" />
                </div>
                <div class="tm-landing-split-copy">
                    <p class="tm-landing-kicker">
                        {detailKicker}
                    </p>
                    <h2>{detailHeading}</h2>
                    {c.subheadline ? <p>{c.subheadline}</p> : null}
                    <ul class="tm-landing-bullets">
                        {proofItems.map((t) => <li>{t}</li>)}
                    </ul>
                </div>
            </div>
        </section>

        <section class="tm-landing-final">
            <div class="tm-landing-shell">
                <h2>{finalHeading}</h2>
                <p>{finalCopy}</p>
                <div class="tm-landing-cta-row">
                    {
                        cta.bookTrigger ? (
                            <button type="button" class="tm-landing-cta" data-tm-booking-trigger>
                                {c.primaryCtaLabel}
                            </button>
                        ) : (
                            <a
                                href={cta.primaryHref}
                                class="tm-landing-cta"
                                {...cta.surface === 'external' ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
                            >
                                {c.primaryCtaLabel}
                            </a>
                        )
                    }
                </div>
            </div>
        </section>
    </main>

    <Fragment slot="after-site-scripts">
        <script is:inline define:vars={{ slug: doc.slug }}>
            (function () {
                var el = document.querySelector('[data-tm-landing-primary]');
                if (!el) return;
                el.addEventListener('click', function () {
                    if (!window.TMAnalytics || typeof window.TMAnalytics.track !== 'function') return;
                    var path = el.getAttribute('data-link-path') || window.location.pathname;
                    window.TMAnalytics.track('cta_click', {
                        cta_id: 'landing_primary_' + slug,
                        link_path: path,
                    });
                });
            })();
        </script>
    </Fragment>
</SiteLayout>
