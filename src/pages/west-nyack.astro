---
import SiteLayout from '../layouts/SiteLayout.astro';
import { definePage } from '../lib/define-page';
import { allLocations } from '../data/locations';
import westNyackMainRaw from '../partials/west-nyack-main.frag.txt?raw';
import { applyTmMediaBase } from '../lib/tm-media';
import { buildLocationGraph, serializeGraph } from '../lib/schema/graph';

const westNyack = allLocations.find((l) => l.slug === 'west-nyack');
if (!westNyack) throw new Error('west-nyack missing from src/data/locations');

const ld = serializeGraph(
    buildLocationGraph('west-nyack', '/west-nyack', [
        { label: 'Home', href: '/' },
        { label: 'Locations', href: '/locations' },
        { label: westNyack.shortName, href: '/west-nyack' },
    ]),
);
const page = definePage({ canonicalPath: '/west-nyack' });
const westNyackMain = applyTmMediaBase(westNyackMainRaw);
---

<SiteLayout
    canonicalPath={page.canonicalPath}
    bodyDataLocation={westNyack.slug}
>
    <Fragment slot="head-extra">
        <link rel="preload" as="image" href="/assets/video/hero-poster-960.webp" type="image/webp" fetchpriority="high" media="(max-width: 768px)" />
        <link rel="preload" as="image" href="/assets/video/hero-poster.jpg" fetchpriority="high" media="(min-width: 769px)" />
        <link rel="stylesheet" href="/css/footer.css?v=3" />
        <link rel="stylesheet" href="/css/newsletter.css?v=3" />
        <link rel="stylesheet" href="/css/ticket-panel.css" />
        <link rel="stylesheet" href="/css/page-west-nyack.css?v=2" />
        <link rel="stylesheet" href="/css/faq.css?v=5" />
    </Fragment>
    <Fragment slot="json-ld">
        <script type="application/ld+json" is:inline set:html={ld}></script>
    </Fragment>
    <div set:html={westNyackMain} />
    <Fragment slot="after-site-scripts">
        <script is:inline>
            window.__TM_PAGE_INIT__ = {
                mode: 'city',
                config: {
                    city: 'West Nyack',
                    taglines: [
                        'Social Gaming Adventure',
                        'Family Game Night on Steroids',
                        'Birthday Parties, Leveled Up',
                        'Where Couch Potatoes Become Heroes',
                        'Touch Grass... Indoors',
                        'Corporate Team Building, But Fun',
                        'Making Memories Together',
                        'Built For Every Age',
                        'Your New Favorite Weekend',
                        'No Screens. Just Fun.',
                        'Team Up. Beat The Clock.'
                    ]
                }
            };
        </script>
        <script defer is:inline src="/js/page-widgets.js?v=6"></script>
    </Fragment>
</SiteLayout>
