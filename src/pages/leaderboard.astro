---
import SiteLayout from '../layouts/SiteLayout.astro';
import Leaderboard from '../components/Leaderboard.astro';
import { definePage } from '../lib/define-page';
import { buildSimpleGraph, serializeGraph } from '../lib/schema/graph';

const page = definePage({ canonicalPath: '/leaderboard' });
const ld = serializeGraph(buildSimpleGraph([
    { label: 'Home', href: '/' },
    { label: 'Leaderboard', href: '/leaderboard' },
]));
---

<SiteLayout canonicalPath={page.canonicalPath} bodyClass="has-noise leaderboard-page">
    <Fragment slot="head-extra">
        <link rel="stylesheet" href="/css/leaderboard.css?v=6" />
    </Fragment>
    <Fragment slot="json-ld">
        <script type="application/ld+json" is:inline set:html={ld}></script>
    </Fragment>
    <header class="leaderboard-page-header">
        <h1 class="section-title" data-i18n="leaderboard.pageTitle">Leaderboard</h1>
        <p class="leaderboard-intro" data-i18n="leaderboard.pageIntro">Bring your crew. Set the score to beat.</p>
    </header>
    <section class="leaderboard-section">
        <Leaderboard />
    </section>
    <Fragment slot="after-site-scripts">
        <script is:inline defer src="/js/leaderboard.js?v=7"></script>
    </Fragment>
</SiteLayout>
