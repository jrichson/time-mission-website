---
import SiteLayout from '../layouts/SiteLayout.astro';
import { definePage } from '../lib/define-page';
import { allLocations } from '../data/locations';
import type { LocationRecord } from '../data/locations';
import {
    locationAddressText,
    locationContactItems,
    locationHref,
    locationStateBadge,
    locationStatusBadge,
    locationHeadlineStatus,
} from '../lib/location-view';
import { buildSimpleGraph, serializeGraph } from '../lib/schema/graph';
import geoAnswerBlocks from '../data/site/geo-answer-blocks.json';

const US_ORDER = [
    'mount-prospect',
    'orland-park',
    'west-nyack',
    'philadelphia',
    'lincoln',
    'dallas',
    'nashville',
    'houston',
    'manassas',
];
const EU_ORDER = ['antwerp', 'brussels'];

function orderLocs(region: string, slugOrder: string[]) {
    const pool = allLocations.filter((l) => l.region === region);
    return slugOrder.map((s) => pool.find((l) => l.slug === s)).filter(Boolean) as LocationRecord[];
}

const usLocs = orderLocs('us', US_ORDER);
const euLocs = orderLocs('europe', EU_ORDER);
const locationsAnswer = geoAnswerBlocks.blocks.locations;

const ld = serializeGraph(
    buildSimpleGraph([
        { label: 'Home', href: '/' },
        { label: 'Locations', href: '/locations' },
    ]),
);
const page = definePage({ canonicalPath: '/locations' });
---

<SiteLayout
    canonicalPath={page.canonicalPath}
    bodyClass="has-noise"
>
    <Fragment slot="head-extra">
        <link rel="stylesheet" href="/css/page-locations.css?v=2" />
    </Fragment>
    <Fragment slot="json-ld">
        <script type="application/ld+json" is:inline set:html={ld}></script>
    </Fragment>

    <div class="locations-page-main">
        <section class="hero">
            <div class="hero-content reveal">
                <div class="section-badge">Find Us</div>
                <h1 class="hero-title">OUR <span>LOCATIONS</span></h1>
                <p class="hero-subtitle">
                    Time Mission is expanding across the globe. Find a location near you and start your adventure.
                </p>
            </div>
        </section>

        <section class="geo-answer-section" aria-labelledby="locations-answer-title">
            <div class="geo-answer-inner">
                <div class="section-badge">Official Location Status</div>
                <h2 id="locations-answer-title">{locationsAnswer.heading}</h2>
                <p class="geo-answer-lead">{locationsAnswer.summary}</p>
                <details class="geo-disclosure">
                    <summary>Read the full location guidance</summary>
                    <p>{locationsAnswer.text}</p>
                </details>
            </div>
        </section>

        <section class="locations-grid">
            <div class="locations-list">
                <div class="loc-group">
                    <div class="loc-group-title">United States</div>
                    {
                        usLocs.map((loc) => (
                            <a
                                href={locationHref(loc)}
                                class:list={[
                                    'loc-row',
                                    'reveal',
                                    { 'is-coming-soon': loc.status === 'coming-soon' },
                                    { 'is-temporarily-closed': loc.status === 'temporarily-closed' },
                                ]}
                            >
                                <span class="loc-state">{locationStateBadge(loc)}</span>
                                <div class="loc-body">
                                    <div class="loc-name">
                                        {loc.shortName}
                                        {locationStatusBadge(loc) ? (
                                            <span class="loc-coming-soon-tag">{locationStatusBadge(loc)}</span>
                                        ) : null}
                                    </div>
                                    <div class="loc-status">{locationHeadlineStatus(loc)}</div>
                                    <div class="loc-address">{locationAddressText(loc)}</div>
                                    <div class="loc-contact">
                                        {
                                            locationContactItems(loc).length ? (
                                                locationContactItems(loc).map((item) => (
                                                    <span class:list={['loc-contact-item', `is-${item.kind}`]}>
                                                        {item.label}
                                                    </span>
                                                ))
                                            ) : (
                                                <span class="loc-contact-muted">Contact details coming soon</span>
                                            )
                                        }
                                    </div>
                                </div>
                                <svg
                                    class="loc-arrow"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    aria-hidden="true"
                                >
                                    <path d="M5 12h14M12 5l7 7-7 7" />
                                </svg>
                            </a>
                        ))
                    }
                </div>

                <div class="loc-group">
                    <div class="loc-group-title">Europe</div>
                    {
                        euLocs.map((loc) => (
                            <a
                                href={locationHref(loc)}
                                class:list={[
                                    'loc-row',
                                    'reveal',
                                    { 'is-coming-soon': loc.status === 'coming-soon' },
                                    { 'is-temporarily-closed': loc.status === 'temporarily-closed' },
                                ]}
                            >
                                <span class="loc-state">{locationStateBadge(loc)}</span>
                                <div class="loc-body">
                                    <div class="loc-name">
                                        {loc.navLabel}
                                        {locationStatusBadge(loc) ? (
                                            <span class="loc-coming-soon-tag">{locationStatusBadge(loc)}</span>
                                        ) : null}
                                    </div>
                                    <div class="loc-status">{locationHeadlineStatus(loc)}</div>
                                    <div class="loc-address">{locationAddressText(loc)}</div>
                                    <div class="loc-contact">
                                        {
                                            locationContactItems(loc).length ? (
                                                locationContactItems(loc).map((item) => (
                                                    <span class:list={['loc-contact-item', `is-${item.kind}`]}>
                                                        {item.label}
                                                    </span>
                                                ))
                                            ) : (
                                                <span class="loc-contact-muted">Contact details coming soon</span>
                                            )
                                        }
                                    </div>
                                </div>
                                <svg
                                    class="loc-arrow"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    aria-hidden="true"
                                >
                                    <path d="M5 12h14M12 5l7 7-7 7" />
                                </svg>
                            </a>
                        ))
                    }
                </div>
            </div>
        </section>

        <section class="newsletter-section">
            <div class="newsletter-inner">
                <h2>DON'T MISS A THING</h2>
                <p>
                    Sign up for sneak peeks and early access to new missions, plus special events, ticket drops,
                    and&nbsp;more.
                </p>
                <form name="newsletter" method="POST" action="/api/newsletter" data-tm-form="newsletter">
                    <input type="hidden" name="form-name" value="newsletter" />
                    <p class="visually-hidden">
                        <label>
                            Do not fill this out if you are human: <input name="bot-field" />
                        </label>
                    </p>
                    <div class="newsletter-form">
                        <label class="visually-hidden" for="newsletter-given-name">First name</label>
                        <input
                            type="text"
                            id="newsletter-given-name"
                            name="given_name"
                            placeholder="First Name"
                            autocomplete="given-name"
                            required
                        />
                        <label class="visually-hidden" for="newsletter-family-name">Last name</label>
                        <input
                            type="text"
                            id="newsletter-family-name"
                            name="family_name"
                            placeholder="Last Name"
                            autocomplete="family-name"
                        />
                        <label class="visually-hidden" for="newsletter-email">Email</label>
                        <input
                            type="email"
                            id="newsletter-email"
                            name="email"
                            placeholder="Email"
                            class="full-width"
                            autocomplete="email"
                            required
                        />
                    </div>
                    <label class="newsletter-consent">
                        <input type="checkbox" name="marketing_opt_in" value="yes" required />
                        <span>I'd like to receive news, updates, and special offers from Time&nbsp;Mission.</span>
                    </label>
                    <div class="tm-turnstile" data-tm-turnstile></div>
                    <button type="submit" class="btn-subscribe">Sign Up</button>
                    <p class="newsletter-legal">
                        By signing up, you agree to our
                        <a href="/terms">Terms of Service</a>
                        {' '}
                        and
                        {' '}
                        <a href="/privacy">Privacy Policy</a>.
                    </p>
                </form>
            </div>
        </section>
    </div>
</SiteLayout>
