---
import SiteLayout from '../layouts/SiteLayout.astro';
import { definePage } from '../lib/define-page';
import { allLocations } from '../data/locations';
import {
    locationsForRegion,
    locationListLabel,
    orderedLocationRegions,
} from '../lib/location-list';
import {
    locationAddressText,
    locationContactItems,
    locationHref,
    locationHrefIsExternal,
    locationStateBadge,
    locationStatusBadge,
    locationHeadlineStatus,
} from '../lib/location-view';
import { buildSimpleGraph, serializeGraph } from '../lib/schema/graph';
import geoAnswerBlocks from '../data/site/geo-answer-blocks.json';
import { activeSiteProfile } from '../lib/site-profile';

const regionMetadata = {
    us: { i18n: 'location.unitedStates', label: 'United States' },
    europe: { i18n: 'location.europe', label: 'Europe' },
} as const;
const locationGroups = orderedLocationRegions(activeSiteProfile.internalRegion).map((region) => ({
    ...regionMetadata[region],
    locations: locationsForRegion(allLocations, region),
    region,
}));
const locationsAnswer = activeSiteProfile.id === 'eu'
    ? geoAnswerBlocks.profiles.eu.locations
    : geoAnswerBlocks.blocks.locations;

const ld = serializeGraph(
    buildSimpleGraph([
        { label: 'Home', href: '/' },
        { label: 'Locations', href: '/locations' },
    ]),
);
const page = definePage({ canonicalPath: '/locations' });
---

<SiteLayout
    canonicalPath={page.canonicalPath}
    bodyClass="has-noise"
>
    <Fragment slot="head-extra">
        <link rel="stylesheet" href="/css/page-locations.css?v=2" />
    </Fragment>
    <Fragment slot="json-ld">
        <script type="application/ld+json" is:inline set:html={ld}></script>
    </Fragment>

    <div class="locations-page-main">
        <section class="hero">
            <div class="hero-content reveal">
                <div class="section-badge">Find Us</div>
                <h1 class="hero-title">OUR <span>LOCATIONS</span></h1>
                <p class="hero-subtitle">
                    Time Mission is expanding across the globe. Find a location near you and start your adventure.
                </p>
            </div>
        </section>

        <section class="geo-answer-section" aria-labelledby="locations-answer-title">
            <div class="geo-answer-inner">
                <div class="section-badge">Official Location Status</div>
                <h2 id="locations-answer-title">{locationsAnswer.heading}</h2>
                <p class="geo-answer-lead">{locationsAnswer.summary}</p>
                <details class="geo-disclosure">
                    <summary>Read the full location guidance</summary>
                    <p data-i18n-html={activeSiteProfile.id === 'eu' ? 'locations.fullGuidance' : undefined} set:html={locationsAnswer.textHtml ?? locationsAnswer.text}></p>
                </details>
            </div>
        </section>

        <section class="locations-grid">
            <div class="locations-list">
                {locationGroups.map((group) => (
                    <div class="loc-group" data-location-region={group.region}>
                        <div class="loc-group-title" data-i18n={group.i18n}>{group.label}</div>
                        {group.locations.map((loc) => {
                            const contactItems = locationContactItems(loc);
                            return (
                                <a
                                    href={locationHref(loc)}
                                    target={locationHrefIsExternal(loc) ? '_blank' : undefined}
                                    rel={locationHrefIsExternal(loc) ? 'noopener' : undefined}
                                    class:list={[
                                        'loc-row',
                                        'reveal',
                                        { 'is-coming-soon': loc.status === 'coming-soon' },
                                        { 'is-temporarily-closed': loc.status === 'temporarily-closed' },
                                    ]}
                                >
                                    <span class="loc-state">{locationStateBadge(loc)}</span>
                                    <div class="loc-body">
                                        <div class="loc-name">
                                            <span>{locationListLabel(loc)}</span>{loc.status === 'coming-soon' && '*'}
                                            {loc.status !== 'coming-soon' && locationStatusBadge(loc) ? (
                                                <span class="loc-coming-soon-tag">{locationStatusBadge(loc)}</span>
                                            ) : null}
                                        </div>
                                        <div class="loc-status">{locationHeadlineStatus(loc)}</div>
                                        <div class="loc-address">{locationAddressText(loc)}</div>
                                        <div class="loc-contact">
                                            {contactItems.length ? (
                                                    contactItems.map((item) => (
                                                        <span class:list={['loc-contact-item', `is-${item.kind}`]}>
                                                            {item.label}
                                                        </span>
                                                    ))
                                                ) : (
                                                    <span class="loc-contact-muted">Contact details coming soon</span>
                                                )}
                                        </div>
                                    </div>
                                    <svg
                                        class="loc-arrow"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        aria-hidden="true"
                                    >
                                        <path d="M5 12h14M12 5l7 7-7 7" />
                                    </svg>
                                </a>
                            );
                        })}
                    </div>
                ))}
            </div>
        </section>

        <section class="newsletter-section">
            <div class="newsletter-inner">
                <h2 data-i18n="home.newsletter.title">DON'T MISS A THING</h2>
                <p data-i18n="home.newsletter.text">
                    Sign up for sneak peeks and early access to new missions, plus special events, ticket drops,
                    and&nbsp;more.
                </p>
                <form name="newsletter" method="POST" action="/api/newsletter" data-tm-form="newsletter">
                    <input type="hidden" name="form-name" value="newsletter" />
                    <p class="visually-hidden">
                        <label>
                            <span data-i18n="home.newsletter.honeypot">Do not fill this out if you are human:</span> <input name="bot-field" />
                        </label>
                    </p>
                    <div class="newsletter-form">
                        <label class="visually-hidden" for="newsletter-given-name" data-i18n="home.newsletter.firstName">First name</label>
                        <input
                            type="text"
                            id="newsletter-given-name"
                            name="given_name"
                            placeholder="First Name" data-i18n-placeholder="home.newsletter.firstNamePlaceholder"
                            autocomplete="given-name"
                            required
                        />
                        <label class="visually-hidden" for="newsletter-family-name" data-i18n="home.newsletter.lastName">Last name</label>
                        <input
                            type="text"
                            id="newsletter-family-name"
                            name="family_name"
                            placeholder="Last Name" data-i18n-placeholder="home.newsletter.lastNamePlaceholder"
                            autocomplete="family-name"
                        />
                        <label class="visually-hidden" for="newsletter-email" data-i18n="home.newsletter.email">Email</label>
                        <input
                            type="email"
                            id="newsletter-email"
                            name="email"
                            placeholder="Email" data-i18n-placeholder="home.newsletter.emailPlaceholder"
                            class="full-width"
                            autocomplete="email"
                            required
                        />
                    </div>
                    <label class="newsletter-consent">
                        <input type="checkbox" name="marketing_opt_in" value="yes" required />
                        <span data-i18n="home.newsletter.consent">I'd like to receive news, updates, and special offers from Time&nbsp;Mission.</span>
                    </label>
                    <div class="tm-turnstile" data-tm-turnstile></div>
                    <button type="submit" class="btn-subscribe" data-i18n="home.newsletter.submit">Sign Up</button>
                    <p class="newsletter-legal">
                        <span data-i18n="home.newsletter.legalPrefix">By signing up, you agree to our</span>
                        {' '}
                        <a href="/terms" data-i18n="home.newsletter.terms">Terms of Service</a>
                        {' '}
                        <span data-i18n="home.newsletter.and">and</span>
                        {' '}
                        <a href="/privacy" data-i18n="home.newsletter.privacy">Privacy Policy</a>.
                    </p>
                </form>
            </div>
        </section>
    </div>
</SiteLayout>
