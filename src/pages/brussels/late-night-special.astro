---
import LocationPromotionPage from '../../components/LocationPromotionPage.astro';
---

<LocationPromotionPage
    bookingPresentation="direct"
    bookingUrl="https://ecom.roller.app/terminal1/timemissionspecialoffer/en/home"
    campaignLabel="Late Night Special"
    ctaId="late_night_special_book_now"
    ctaLabel="Book Your Night"
    eyebrow="Brussels · Thursday to Saturday from 6 PM"
    headlineLines={['Your Night Out,', 'Upgraded']}
    image={{
        alt: 'Guests line up at the robot bartender at Time Mission Brussels',
        position: 'right',
        src: '/assets/photos/promos/brussels-late-night-1200.webp',
        srcSet: '/assets/photos/promos/brussels-late-night-480.webp 480w, /assets/photos/promos/brussels-late-night-800.webp 800w, /assets/photos/promos/brussels-late-night-1200.webp 1200w, /assets/photos/promos/brussels-late-night-1600.webp 1600w',
    }}
    subhead="90 minutes + a robot-made cocktail. €31.99 per person."
    paragraphs={[
        "Dinner and drinks? Been there. Every Thursday to Saturday from 6 PM, Time Mission Brussels turns into the city's most competitive night out. Grab your date, your best friends, or the whole office crew and take on 25+ interactive mission rooms. Dodge lasers, outsmart puzzles, survive the floor of lava, and find out once and for all who's really the most competitive one in your group.",
        "When the clock runs out, head to the bar where our robot bartender is ready to shake up your cocktail. Yes, an actual robot. Cheers to the winners, and a little sympathy for everyone else. Then start planning your rematch.",
    ]}
    locationName="Brussels"
    locationSlug="brussels"
    pageSlug="late-night-special"
/>
