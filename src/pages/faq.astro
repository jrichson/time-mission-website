---
import SiteLayout from '../layouts/SiteLayout.astro';
import { definePage } from '../lib/define-page';
import Faq from '../components/Faq.astro';
import faqs from '../data/site/faqs.json';
import geoAnswerBlocks from '../data/site/geo-answer-blocks.json';
import { buildFaqGraph, serializeGraph } from '../lib/schema/graph';
import { activeSiteProfile } from '../lib/site-profile';

const ld = serializeGraph(buildFaqGraph());
const page = definePage({ canonicalPath: '/faq' });
const faqAnswer = geoAnswerBlocks.blocks.faq;
---

<SiteLayout
    canonicalPath={page.canonicalPath}
>
    <Fragment slot="head-extra">
        <link rel="stylesheet" href="/css/faq.css?v=5" />
        <link rel="stylesheet" href="/css/page-faq.css?v=1" />
    </Fragment>
    <Fragment slot="json-ld">
        <script type="application/ld+json" is:inline set:html={ld}></script>
    </Fragment>

    <div class="faq-main">
        <section class="page-header">
            <div class="reveal">
                <div class="section-badge">Got Questions?</div>
                <h1 class="section-title">FREQUENTLY ASKED QUESTIONS</h1>
                <p class="page-subtitle">
                    Everything you need to know before your Time Mission adventure. Can't find what you're looking for?
                    Contact us directly.
                </p>
            </div>
        </section>
        <section class="faq-answer-summary" aria-labelledby="faq-answer-summary-title">
            <div class="faq-answer-summary-inner">
                <div class="section-badge">Before You Visit</div>
                <h2 id="faq-answer-summary-title">{faqAnswer.heading}</h2>
                <p class="geo-answer-lead">{faqAnswer.summary}</p>
                <details class="geo-disclosure">
                    <summary>Read the full pre-visit guidance</summary>
                    <p data-i18n-html="faq.fullGuidance" set:html={faqAnswer.textHtml ?? faqAnswer.text}></p>
                </details>
            </div>
        </section>
        {
            faqs.sections.map((section) => (
                <section class="faq-section" id={section.id}>
                    <Faq heading={section.heading} items={section.items.filter((item) =>
                        activeSiteProfile.id !== 'eu' || item.q !== 'Do you offer a military discount?'
                    )} />
                </section>
            ))
        }

        <section class="cta-section">
            <div class="cta-content reveal">
                <h2 class="cta-title">STILL HAVE QUESTIONS?</h2>
                <p class="cta-text">Can't find what you're looking for? We're happy to help.</p>
                <a href="/contact" class="btn-primary">
                    Contact Us
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M5 12h14M12 5l7 7-7 7"></path>
                    </svg>
                </a>
            </div>
        </section>

        <section class="newsletter-section">
            <div class="newsletter-inner">
                <h2 data-i18n="home.newsletter.title">DON'T MISS A THING</h2>
                <p data-i18n="home.newsletter.text">Sign up for sneak peeks and early access to new missions, plus special events, ticket drops, and&nbsp;more.</p>
                <form name="newsletter" method="POST" action="/api/newsletter" data-tm-form="newsletter">
                    <input type="hidden" name="form-name" value="newsletter" />
                    <p class="visually-hidden">
                        <label>
                            <span data-i18n="home.newsletter.honeypot">Do not fill this out if you are human:</span> <input name="bot-field" />
                        </label>
                    </p>
                    <div class="newsletter-form">
                        <label class="visually-hidden" for="newsletter-given-name" data-i18n="home.newsletter.firstName">First name</label>
                        <input
                            type="text"
                            id="newsletter-given-name"
                            name="given_name"
                            placeholder="First Name" data-i18n-placeholder="home.newsletter.firstNamePlaceholder"
                            autocomplete="given-name"
                            required
                        />
                        <label class="visually-hidden" for="newsletter-family-name" data-i18n="home.newsletter.lastName">Last name</label>
                        <input
                            type="text"
                            id="newsletter-family-name"
                            name="family_name"
                            placeholder="Last Name" data-i18n-placeholder="home.newsletter.lastNamePlaceholder"
                            autocomplete="family-name"
                        />
                        <label class="visually-hidden" for="newsletter-email" data-i18n="home.newsletter.email">Email</label>
                        <input
                            type="email"
                            id="newsletter-email"
                            name="email"
                            placeholder="Email" data-i18n-placeholder="home.newsletter.emailPlaceholder"
                            class="full-width"
                            autocomplete="email"
                            required
                        />
                    </div>
                    <label class="newsletter-consent">
                        <input type="checkbox" name="marketing_opt_in" value="yes" required />
                        <span data-i18n="home.newsletter.consent">I'd like to receive news, updates, and special offers from Time&nbsp;Mission.</span>
                    </label>
                    <div class="tm-turnstile" data-tm-turnstile></div>
                    <button type="submit" class="btn-subscribe" data-i18n="home.newsletter.submit">Sign Up</button>
                    <p class="newsletter-legal">
                        <span data-i18n="home.newsletter.legalPrefix">By signing up, you agree to our</span>
                        {' '}
                        <a href="/terms" data-i18n="home.newsletter.terms">Terms of Service</a>
                        {' '}
                        <span data-i18n="home.newsletter.and">and</span>
                        {' '}
                        <a href="/privacy" data-i18n="home.newsletter.privacy">Privacy Policy</a>.
                    </p>
                </form>
            </div>
        </section>
    </div>

    <Fragment slot="after-site-scripts">
        <script is:inline defer src="/js/page-faq-after.js?v=1"></script>
    </Fragment>
</SiteLayout>
