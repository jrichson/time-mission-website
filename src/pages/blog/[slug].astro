---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { allLocations } from '../../data/locations';
import { definePage } from '../../lib/define-page';
import {
    blogLocationCanonicalPath,
    blogPostBodyHtml,
    blogPostCanonicalPath,
    blogPostDateLabel,
    blogPostExcerptForDoc,
    blogPostExcerptHtmlForDoc,
    blogPostExternalPublisher,
    blogPostExternalUrl,
    blogPostHeadForDoc,
    blogPostHeroImage,
    blogPostLocationSlug,
    blogPostPublishDateTime,
    blogPostShouldHaveDetailPage,
    blogPostShowsInPressRoom,
    getPublishedBlogPosts,
    sortBlogPosts,
    type PayloadBlogPostDoc,
} from '../../lib/payload/load';
import { buildArticleGraph, buildSimpleGraph, serializeGraph } from '../../lib/schema/graph';

export const prerender = true;

export async function getStaticPaths() {
    const posts = sortBlogPosts((await getPublishedBlogPosts()).filter(blogPostShouldHaveDetailPage));
    const locationPaths = allLocations
        .filter((location) => posts.some((post) => blogPostLocationSlug(post) === location.slug))
        .map((location) => ({
            params: { slug: location.slug },
            props: {
                kind: 'location',
                locationSlug: location.slug,
                posts: posts.filter((post) => blogPostLocationSlug(post) === location.slug),
            },
        }));
    const postPaths = posts.map((post) => ({
        params: { slug: post.slug },
        props: { kind: 'post', post },
    }));

    return [...locationPaths, ...postPaths];
}

type BlogRouteProps =
    | { kind: 'location'; locationSlug: string; posts: PayloadBlogPostDoc[] }
    | { kind: 'post'; post: PayloadBlogPostDoc };

const props = Astro.props as BlogRouteProps;
const location =
    props.kind === 'location'
        ? allLocations.find((loc) => loc.slug === props.locationSlug)!
        : allLocations.find((loc) => loc.slug === blogPostLocationSlug(props.post));
const locationName = location?.shortName || 'Time Mission';
const locationPath = location ? `/${location.slug}` : '/locations';
const post = props.kind === 'post' ? props.post : null;
const isPressRelease = post ? blogPostShowsInPressRoom(post) : false;
const postBackHref = isPressRelease
    ? '/press/releases'
    : location
        ? blogLocationCanonicalPath(location.slug)
        : '/press/releases';
const postBackLabel = isPressRelease ? 'Press Releases' : location?.shortName || 'Press Room';
const locationPosts = props.kind === 'location' ? props.posts : [];
const page = definePage({
    canonicalPath: props.kind === 'post'
        ? blogPostCanonicalPath(String(props.post.slug))
        : blogLocationCanonicalPath(String(props.locationSlug)),
});
const externalUrl = post ? blogPostExternalUrl(post) : '';
const externalPublisher = post ? blogPostExternalPublisher(post) : '';
const landingHead = post
    ? blogPostHeadForDoc(post)
    : {
        metaTitle: `${locationName} Blog | Time Mission`,
        metaDescription: `Updates and local news from Time Mission ${locationName}.`,
        robots: 'index,follow',
        ogImage: '/assets/photos/experiences/Time-Mission_Magma_Mayhem-2.jpg',
        twitterImage: '/assets/photos/experiences/Time-Mission_Magma_Mayhem-2.jpg',
    };
const schemaCrumbs = post
    ? [
        { label: 'Home', href: '/' },
        ...(isPressRelease
            ? [
                { label: 'Press', href: '/press' },
                { label: 'Press Releases', href: '/press/releases' },
            ]
            : [{ label: 'Blog', href: '/blog' }]),
        { label: String(post.title), href: page.canonicalPath },
    ]
    : [
        { label: 'Home', href: '/' },
        { label: 'Blog', href: '/blog' },
        { label: locationName, href: page.canonicalPath },
    ];
const ld = serializeGraph(post
    ? buildArticleGraph({
        canonicalPath: page.canonicalPath,
        crumbs: schemaCrumbs,
        datePublished: blogPostPublishDateTime(post),
        description: blogPostExcerptForDoc(post),
        headline: String(post.title),
        image: blogPostHeroImage(post),
        newsArticle: isPressRelease,
    })
    : buildSimpleGraph(schemaCrumbs));
---

<SiteLayout
    canonicalPath={page.canonicalPath}
    landingHead={landingHead}
    ogType={post ? 'article' : 'website'}
    publishedTime={post ? blogPostPublishDateTime(post) : undefined}
    bodyClass={`has-noise tm-blog-page${isPressRelease ? ' tm-press-article-page' : ''}`}
>
    <Fragment slot="head-extra">
        <link rel="stylesheet" href="/css/page-blog.css?v=3" />
    </Fragment>
    <Fragment slot="json-ld">
        <script type="application/ld+json" is:inline set:html={ld}></script>
    </Fragment>

    {post ? (
        <>
            <article class="tm-blog-article">
                <header class:list={["tm-blog-article-hero", { "tm-blog-article-hero--press": isPressRelease }]}>
                    <picture class="tm-blog-article-media" aria-hidden="true">
                        <source srcset={blogPostHeroImage(post)}>
                        <img src={blogPostHeroImage(post)} alt="" width="1600" height="1067" loading="eager" fetchpriority="high" decoding="async">
                    </picture>
                    <div class="tm-blog-shell tm-blog-article-copy">
                        <a class="tm-blog-back" href={postBackHref}>{postBackLabel}</a>
                        <div data-page-i18n={isPressRelease ? 'ignore' : undefined}>
                            <p class="tm-blog-kicker">
                                {isPressRelease ? 'Press Release · ' : ''}{blogPostDateLabel(post)}
                            </p>
                            <h1>{post.title}</h1>
                            <div class="tm-blog-article-excerpt" set:html={blogPostExcerptHtmlForDoc(post)} />
                        </div>
                    </div>
                </header>
                {externalUrl ? (
                    <div class="tm-blog-shell tm-blog-body">
                        <aside class="tm-blog-source-card">
                            <p class="tm-blog-kicker">Shared from the source</p>
                            <h2>{externalPublisher || 'External coverage'}</h2>
                            <p>This story is hosted by the original publisher. Open it there to read the complete article.</p>
                            <a href={externalUrl} target="_blank" rel="noopener noreferrer">Read the original story</a>
                        </aside>
                    </div>
                ) : (
                    <div
                        class="tm-blog-shell tm-blog-body"
                        data-page-i18n={isPressRelease ? 'ignore' : undefined}
                        set:html={blogPostBodyHtml(post)}
                    />
                )}
            </article>
        </>
    ) : (
        <>
            <section class="tm-blog-hero tm-blog-hero--compact">
                <picture class="tm-blog-hero-media" aria-hidden="true">
                    <source srcset="/assets/photos/experiences/Time-Mission_Magma_Mayhem-2.jpg" type="image/jpeg">
                    <img src="/assets/photos/experiences/Time-Mission_Magma_Mayhem-2.jpg" alt="" width="1600" height="1067" loading="eager" fetchpriority="high" decoding="async">
                </picture>
                <div class="tm-blog-shell tm-blog-hero-copy">
                    <p class="tm-blog-kicker">Location Blog</p>
                    <h1>{locationName}</h1>
                    <p>Local news, event ideas, and opening updates from Time Mission {locationName}.</p>
                    <div class="tm-blog-actions">
                        <a href="/blog" class="tm-blog-secondary">All Blog Posts</a>
                        <a href={locationPath} class="tm-blog-button">Visit Location</a>
                    </div>
                </div>
            </section>
            <section class="tm-blog-section">
                <div class="tm-blog-shell">
                    {locationPosts.length ? (
                        <div class="tm-blog-grid">
                            {locationPosts.map((item) => (
                                <article class="tm-blog-card">
                                    <a href={blogPostCanonicalPath(String(item.slug))}>
                                        <img src={blogPostHeroImage(item)} alt="" width="720" height="480" loading="lazy" decoding="async" />
                                        <span>
                                            {blogPostExternalPublisher(item)
                                                ? `Shared from ${blogPostExternalPublisher(item)} · `
                                                : ''}
                                            {blogPostDateLabel(item)}
                                        </span>
                                        <h3>{item.title}</h3>
                                        <div class="tm-blog-card-excerpt" set:html={blogPostExcerptHtmlForDoc(item)} />
                                    </a>
                                </article>
                            ))}
                        </div>
                    ) : (
                        <div class="tm-blog-empty">
                            <h2>{locationName} stories are on the way.</h2>
                            <p>Check back for local news, event ideas, and mission-room updates. You can still visit the location page for hours, booking, and contact details.</p>
                            <div class="tm-blog-actions">
                                <a href="/blog" class="tm-blog-secondary">Back to Blog</a>
                                <a href={locationPath} class="tm-blog-button">Visit Location</a>
                            </div>
                        </div>
                    )}
                </div>
            </section>
        </>
    )}
</SiteLayout>
