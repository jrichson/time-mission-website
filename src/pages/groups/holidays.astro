---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { definePage } from '../../lib/define-page';
import holidaysMain from '../../partials/holidays-main.frag.txt?raw';
import faqs from '../../data/site/faqs.json';
import { buildGroupEventGraph, serializeGraph } from '../../lib/schema/graph';

const faqItems = faqs.sections.find((s) => s.id === 'holidays')?.items ?? [];
const ld = serializeGraph(
    buildGroupEventGraph({
        canonicalPath: '/groups/holidays',
        crumbs: [
            { label: 'Home', href: '/' },
            { label: 'Groups', href: '/groups' },
            { label: 'Holiday Parties', href: '/groups/holidays' },
        ],
        serviceName: 'Holiday Party Hosting',
        serviceType: 'BusinessEvent',
        serviceDescription:
            'Holiday parties and full-venue buyouts at Time Mission for teams and families up to 125 guests with high-energy missions and friendly competition.',
        faqs: faqItems,
    }),
);
const page = definePage({ canonicalPath: '/groups/holidays' });
---

<SiteLayout
    canonicalPath={page.canonicalPath}
    bodyClass="has-noise"
>
    <Fragment slot="head-extra">
        <link rel="preload" as="image" href="/assets/photos/groups/holiday-parties-480.webp" imagesrcset="/assets/photos/groups/holiday-parties-480.webp 480w, /assets/photos/groups/holiday-parties-800.webp 800w, /assets/photos/groups/holiday-parties-1200.webp 1200w, /assets/photos/groups/holiday-parties-1600.webp 1600w" imagesizes="100vw" type="image/webp" fetchpriority="high" />
        <link rel="stylesheet" href="/css/faq.css?v=5" />
        <link rel="stylesheet" href="/css/page-group-event.css?v=1" />
    </Fragment>
    <Fragment slot="json-ld">
        <script type="application/ld+json" is:inline set:html={ld}></script>
    </Fragment>
    <div set:html={holidaysMain} />
    <Fragment slot="after-site-scripts">
        <script is:inline defer src="/js/page-group-event-after.js?v=1"></script>
    </Fragment>
</SiteLayout>
