---
import SiteLayout from '../layouts/SiteLayout.astro';
import ComingSoonLocationPage from '../components/ComingSoonLocationPage.astro';
import { definePage } from '../lib/define-page';
import { allLocations } from '../data/locations';
import { buildLocationGraph, serializeGraph } from '../lib/schema/graph';

const slug = 'dallas';
const location = allLocations.find((l) => l.slug === slug);
if (!location) throw new Error(`${slug} missing from src/data/locations`);

const canonicalPath = `/${slug}`;
const page = definePage({ canonicalPath });
const ld = serializeGraph(
    buildLocationGraph(slug, canonicalPath, [
        { label: 'Home', href: '/' },
        { label: 'Locations', href: '/locations' },
        { label: location.shortName, href: canonicalPath },
    ]),
);
const contactHref = `/contact?location=${encodeURIComponent(slug)}&type=updates`;
const pageInit = {
    mode: 'city',
    config: {
        city: location.shortName,
        taglines: [
            'Coming Soon',
            'Social Gaming Adventure',
            'Family Game Night on Steroids',
            'Birthday Parties, Leveled Up',
            'Corporate Team Building, But Fun',
            'Built For Every Age',
            'Team Up. Beat The Clock.',
        ],
    },
};
---

<SiteLayout
    canonicalPath={page.canonicalPath}
    bodyDataLocation={location.slug}
    bookingCtaHref={contactHref}
    bookingCtaLabel="Contact Us"
    bookingCtaIsBookingTrigger={false}
    bookingCtaI18n=""
>
    <Fragment slot="head-extra">
        <link rel="preload" as="image" href="/assets/video/hero-poster-960.webp" type="image/webp" fetchpriority="high" media="(max-width: 768px)" />
        <link rel="preload" as="image" href="/assets/video/hero-poster.jpg" fetchpriority="high" media="(min-width: 769px)" />
        <link rel="stylesheet" href="/css/footer.css?v=3" />
        <link rel="stylesheet" href="/css/newsletter.css?v=3" />
        <link rel="stylesheet" href="/css/ticket-panel.css" />
        <link rel="stylesheet" href="/css/page-houston.css?v=2" />
    </Fragment>
    <Fragment slot="json-ld">
        <script type="application/ld+json" is:inline set:html={ld}></script>
    </Fragment>
    <ComingSoonLocationPage slug={slug} />
    <Fragment slot="after-site-scripts">
        <script is:inline define:vars={{ pageInit }}>
            window.__TM_PAGE_INIT__ = pageInit;
        </script>
        <script defer is:inline src="/js/page-widgets.js?v=5"></script>
    </Fragment>
</SiteLayout>
