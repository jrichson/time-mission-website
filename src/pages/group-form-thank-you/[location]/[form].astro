---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { definePage } from '../../../lib/define-page';
import { groupFormThankYouPaths, type GroupFormThankYouPath } from '../../../lib/group-form-thank-you-routes';

export function getStaticPaths() {
    return groupFormThankYouPaths().map((entry) => ({
        params: {
            location: entry.location.slug || entry.location.id,
            form: entry.formKey,
        },
        props: entry,
    }));
}

const {
    location,
    formKey,
    formLabel,
    canonicalPath,
} = Astro.props as GroupFormThankYouPath;

const page = definePage({ canonicalPath });
const locationName = location.shortName || location.name;
const landingHead = {
    metaTitle: `Thanks for your ${formLabel} request | Time Mission ${locationName}`,
    metaDescription: `Time Mission ${locationName} received your ${formLabel} request and will follow up with next steps.`,
    robots: 'noindex, nofollow',
    canonicalOverride: null,
    ogImage: '/assets/photos/groups/corporate-events-1200.webp',
    twitterImage: '/assets/photos/groups/corporate-events-1200.webp',
};
---

<SiteLayout
    canonicalPath={page.canonicalPath}
    bodyClass="has-noise"
    bodyDataLocation={location.slug || location.id}
    landingHead={landingHead}
>
    <Fragment slot="page-style">
        <style is:global>
            .group-form-thank-you {
                min-height: 62vh;
                display: grid;
                align-items: center;
                padding: clamp(5rem, 10vw, 8rem) clamp(1.25rem, 4vw, 4rem);
                background: var(--black);
            }

            .group-form-thank-you__inner {
                width: min(920px, 100%);
                margin: 0 auto;
                border-top: 1px solid rgba(255, 107, 44, 0.5);
                padding-top: clamp(2rem, 5vw, 3.5rem);
            }

            .group-form-thank-you__eyebrow {
                margin: 0 0 1rem;
                color: var(--orange);
                font-size: 0.78rem;
                font-weight: 800;
                letter-spacing: 0;
                text-transform: uppercase;
            }

            .group-form-thank-you h1 {
                max-width: 780px;
                margin: 0;
                font-family: var(--display);
                font-size: 5.6rem;
                line-height: 0.92;
                letter-spacing: 0;
                text-transform: uppercase;
            }

            .group-form-thank-you p {
                max-width: 620px;
                margin: 1.4rem 0 0;
                color: var(--gray);
                font-size: 1.12rem;
                line-height: 1.65;
            }

            .group-form-thank-you__actions {
                display: flex;
                flex-wrap: wrap;
                gap: 0.85rem;
                margin-top: 2rem;
            }

            .group-form-thank-you__actions a {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-height: 48px;
                padding: 0.85rem 1.15rem;
                border: 1px solid rgba(255, 255, 255, 0.18);
                color: var(--white);
                font-size: 0.78rem;
                font-weight: 800;
                letter-spacing: 0;
                text-decoration: none;
                text-transform: uppercase;
            }

            .group-form-thank-you__actions a:first-child {
                border-color: transparent;
                background: var(--gradient-primary);
            }

            @media (max-width: 720px) {
                .group-form-thank-you h1 {
                    font-size: 3.5rem;
                }

                .group-form-thank-you p {
                    font-size: 1rem;
                }

                .group-form-thank-you__actions a {
                    width: 100%;
                }
            }
        </style>
    </Fragment>

    <section
        class="group-form-thank-you"
        data-tm-group-form-thank-you
        data-location-slug={location.slug || location.id}
        data-location-name={locationName}
        data-region={location.region}
        data-form-subject={formKey}
    >
        <div class="group-form-thank-you__inner">
            <p class="group-form-thank-you__eyebrow">{locationName} / {formLabel}</p>
            <h1>Request Received</h1>
            <p>
                Thanks. The Time Mission team received your {formLabel} request for {locationName} and will follow up with next steps.
            </p>
            <div class="group-form-thank-you__actions" aria-label="Next steps">
                <a href={`/groups/${formKey === 'default' ? '' : formKey}`.replace(/\/$/, '') || '/groups'}>Back to group events</a>
                <a href={`/${location.slug || location.id}`}>View {locationName}</a>
            </div>
        </div>
    </section>

    <Fragment slot="after-site-scripts">
        <script is:inline defer src="/js/group-form-thank-you.js?v=4"></script>
    </Fragment>
</SiteLayout>
