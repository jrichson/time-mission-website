---
import SiteLayout from '../layouts/SiteLayout.astro';
import { allLocations } from '../data/locations';
import { definePage } from '../lib/define-page';
import { buildSimpleGraph, serializeGraph } from '../lib/schema/graph';
import {
    blogLocationCanonicalPath,
    blogPostCanonicalPath,
    blogPostDateLabel,
    blogPostDocLooksRenderable,
    blogPostExcerptHtmlForDoc,
    blogPostExternalPublisher,
    blogPostHeroImage,
    blogPostLocationSlug,
    blogPostShowsInPressRoom,
    getPublishedBlogPosts,
    sortBlogPosts,
    type PayloadBlogPostDoc,
} from '../lib/payload/load';

export const prerender = true;

const page = definePage({ canonicalPath: '/blog' });
const posts = sortBlogPosts((await getPublishedBlogPosts()).filter(blogPostDocLooksRenderable));
const postsByLocation = new Map<string, PayloadBlogPostDoc[]>();
for (const post of posts) {
    const locationSlug = blogPostLocationSlug(post);
    if (!postsByLocation.has(locationSlug)) postsByLocation.set(locationSlug, []);
    postsByLocation.get(locationSlug)!.push(post);
}
const locationsWithPosts = allLocations.filter((loc) => (postsByLocation.get(loc.slug) || []).length > 0);
const ld = serializeGraph(buildSimpleGraph([
    { label: 'Home', href: '/' },
    { label: 'Blog', href: '/blog' },
]));
---

<SiteLayout canonicalPath={page.canonicalPath} bodyClass="has-noise tm-blog-page">
    <Fragment slot="head-extra">
        <link rel="stylesheet" href="/css/page-blog.css?v=2" />
    </Fragment>
    <Fragment slot="json-ld">
        <script type="application/ld+json" is:inline set:html={ld}></script>
    </Fragment>

    <section class="tm-blog-hero">
        <picture class="tm-blog-hero-media" aria-hidden="true">
            <source srcset="/assets/photos/experiences/Time-Mission_Magma_Mayhem-2.jpg" type="image/jpeg">
            <img src="/assets/photos/experiences/Time-Mission_Magma_Mayhem-2.jpg" alt="" width="1600" height="1067" loading="eager" fetchpriority="high" decoding="async">
        </picture>
        <div class="tm-blog-shell tm-blog-hero-copy">
            <p class="tm-blog-kicker">Field Notes</p>
            <h1>TIME MISSION BLOG</h1>
            <p>Local updates, opening notes, event ideas, and mission-room news from Time Mission teams.</p>
            <div class="tm-blog-actions">
                {locationsWithPosts.length ? (
                    <a href="#browse-by-location" class="tm-blog-button">Browse by Location</a>
                ) : null}
                <a href="/locations" class="tm-blog-secondary">Find a Location</a>
            </div>
        </div>
    </section>

    <section class="tm-blog-section">
        <div class="tm-blog-shell">
            <div class="tm-blog-section-head">
                <p class="tm-blog-kicker">Latest</p>
                <h2>Recent posts</h2>
            </div>
            {posts.length ? (
                <div class="tm-blog-grid">
                    {posts.map((post) => {
                        const location = allLocations.find((loc) => loc.slug === blogPostLocationSlug(post));
                        const isPressRelease = blogPostShowsInPressRoom(post);
                        return (
                            <article class="tm-blog-card">
                                <a
                                    href={blogPostCanonicalPath(String(post.slug))}
                                    data-page-i18n={isPressRelease ? 'ignore' : undefined}
                                >
                                    <img src={blogPostHeroImage(post)} alt="" width="720" height="480" loading="lazy" decoding="async" />
                                    <span>
                                        {blogPostExternalPublisher(post)
                                            ? `Shared from ${blogPostExternalPublisher(post)}`
                                            : location?.shortName || 'Time Mission'}
                                        {' · '}
                                        {blogPostDateLabel(post)}
                                    </span>
                                    <h3>{post.title}</h3>
                                    <div class="tm-blog-card-excerpt" set:html={blogPostExcerptHtmlForDoc(post)} />
                                </a>
                            </article>
                        );
                    })}
                </div>
            ) : (
                <div class="tm-blog-empty">
                    <h3>Stories are on the way.</h3>
                    <p>Check back for opening updates, event ideas, and mission-room news from Time Mission teams.</p>
                </div>
            )}
        </div>
    </section>

    {locationsWithPosts.length ? (
        <section class="tm-blog-section tm-blog-section--quiet" id="browse-by-location">
            <div class="tm-blog-shell">
                <div class="tm-blog-section-head">
                    <p class="tm-blog-kicker">Locations</p>
                    <h2>Browse by location</h2>
                    <p>Choose your location for local news, opening updates, and event ideas.</p>
                </div>
                <div class="tm-blog-location-list">
                    {locationsWithPosts.map((loc) => {
                        const postCount = (postsByLocation.get(loc.slug) || []).length;
                        return (
                            <a href={blogLocationCanonicalPath(loc.slug)}>
                                <span>{loc.navLabel}</span>
                                <strong>{`${postCount} ${postCount === 1 ? 'post' : 'posts'}`}</strong>
                            </a>
                        );
                    })}
                </div>
            </div>
        </section>
    ) : null}
</SiteLayout>
