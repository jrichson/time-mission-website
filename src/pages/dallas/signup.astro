---
import KlaviyoEmbedForm from '../../components/KlaviyoEmbedForm.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { definePage } from '../../lib/define-page';
import { buildSimpleGraph, serializeGraph } from '../../lib/schema/graph';
import { allLocations } from '../../data/locations';
import { locationCtaView } from '../../lib/location-view';

const page = definePage({ canonicalPath: '/dallas/signup' });
const formId = 'QYqsMS';
const dallas = allLocations.find((loc) => loc.slug === 'dallas');
if (!dallas) throw new Error('dallas missing from src/data/locations');
const cta = locationCtaView(dallas);
const ld = serializeGraph(buildSimpleGraph([
    { label: 'Home', href: '/' },
    { label: 'Dallas', href: '/dallas' },
    { label: 'Ticket Sign-Up', href: page.canonicalPath },
]));
---

<SiteLayout canonicalPath={page.canonicalPath} bodyClass="has-noise tm-promo-page tm-signup-embed-page" bodyDataLocation="dallas"
    bookingCtaHref={cta.href}
    bookingCtaLabel={cta.label}
    bookingCtaI18n={cta.i18n}
>
    <Fragment slot="head-extra">
        <link rel="stylesheet" href="/css/page-promo.css?v=7" />
    </Fragment>
    <Fragment slot="json-ld">
        <script type="application/ld+json" is:inline set:html={ld}></script>
    </Fragment>
    <section class="tm-signup-embed" aria-labelledby="dallas-signup-title">
        <h1 id="dallas-signup-title" class="visually-hidden">Time Mission Dallas Ticket Sign-Up</h1>
        <div class="tm-signup-embed__form">
            <KlaviyoEmbedForm formId={formId} formName="dallas_ticket_signup" />
        </div>
    </section>
</SiteLayout>
