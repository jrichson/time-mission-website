---
import SiteLayout from '../layouts/SiteLayout.astro';
import { definePage } from '../lib/define-page';
import indexMainRaw from '../partials/index-main.frag.txt?raw';
import { applyTmMediaBase } from '../lib/tm-media';
import indexPrenav from '../partials/index-prenav.frag.txt?raw';
import { buildHomeGraph, serializeGraph } from '../lib/schema/graph';
import { homePageTaglines } from '../lib/page-taglines';
import PageWidgetsScripts from '../components/PageWidgetsScripts.astro';

const ld = serializeGraph(buildHomeGraph());
const page = definePage({ canonicalPath: '/' });
const indexMain = applyTmMediaBase(indexMainRaw);
const pageInit = {
    mode: 'index',
    config: {
        taglines: homePageTaglines(),
    },
};
---

<SiteLayout
    canonicalPath={page.canonicalPath}
>
    <Fragment slot="head-extra">
        <link rel="preload" as="image" href="/assets/video/hero-poster-960.webp" type="image/webp" fetchpriority="high" media="(max-width: 768px)" />
        <link rel="preload" as="image" href="/assets/video/hero-poster.jpg" fetchpriority="high" media="(min-width: 769px)" />
        <link rel="stylesheet" href="/css/page-index.css?v=4" />
        <link rel="stylesheet" href="/css/page-index-hero.css?v=1" />
        <link rel="stylesheet" href="/css/page-index-intro-stats.css?v=1" />
        <link rel="stylesheet" href="/css/page-index-experiences.css?v=1" />
        <link rel="stylesheet" href="/css/page-index-groups.css?v=1" />
        <link rel="stylesheet" href="/css/page-index-flow.css?v=1" />
        <link rel="stylesheet" href="/css/faq.css?v=5" />
    </Fragment>
    <Fragment slot="json-ld">
        <script type="application/ld+json" is:inline set:html={ld}></script>
    </Fragment>
    <Fragment slot="pre-nav" set:html={indexPrenav} />
    <div class="home-main" set:html={indexMain} />
    <Fragment slot="after-site-scripts">
        <PageWidgetsScripts pageInit={pageInit} />
    </Fragment>
</SiteLayout>
