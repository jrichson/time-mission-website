---
import SiteLayout from '../layouts/SiteLayout.astro';
import { definePage } from '../lib/define-page';
import licensingMainRaw from '../partials/licensing-main.frag.txt?raw';
import { buildSimpleGraph, serializeGraph } from '../lib/schema/graph';
import { activeSiteProfile } from '../lib/site-profile';
import { applyRegionalContentTokens } from '../lib/regional-content';

const licensingMain = applyRegionalContentTokens(licensingMainRaw, activeSiteProfile);

const ld = serializeGraph(
    buildSimpleGraph([
        { label: 'Home', href: '/' },
        { label: 'Licensing', href: '/licensing' },
    ]),
);
const page = definePage({ canonicalPath: '/licensing' });
---

<SiteLayout
    canonicalPath={page.canonicalPath}
    bodyClass="has-noise"
>
    <Fragment slot="head-extra">
        <link rel="stylesheet" href="/css/page-legal.css?v=1" />
    </Fragment>
    <Fragment slot="json-ld">
        <script type="application/ld+json" is:inline set:html={ld}></script>
    </Fragment>
    <div set:html={licensingMain} />
</SiteLayout>
