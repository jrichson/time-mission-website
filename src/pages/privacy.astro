---
import SiteLayout from '../layouts/SiteLayout.astro';
import { definePage } from '../lib/define-page';
import privacyMainRaw from '../partials/privacy-main.frag.txt?raw';
import { buildSimpleGraph, serializeGraph } from '../lib/schema/graph';
import OperatorContactList from '../components/OperatorContactList.astro';
import { activeSiteProfile } from '../lib/site-profile';
import { applyRegionalContentTokens, splitHtmlSlot } from '../lib/regional-content';

const operatorContactsSlot = '<!-- OPERATOR_CONTACTS_SLOT -->';
const privacyMain = applyRegionalContentTokens(privacyMainRaw, activeSiteProfile);
const [privacyMainBeforeContacts, privacyMainAfterContacts] = splitHtmlSlot(
    privacyMain,
    operatorContactsSlot,
    'Privacy operator contacts slot',
);

const ld = serializeGraph(
    buildSimpleGraph([
        { label: 'Home', href: '/' },
        { label: 'Privacy', href: '/privacy' },
    ]),
);
const page = definePage({ canonicalPath: '/privacy' });
---

<SiteLayout
    canonicalPath={page.canonicalPath}
    bodyClass="has-noise"
>
    <Fragment slot="head-extra">
        <link rel="stylesheet" href="/css/page-legal.css?v=1" />
    </Fragment>
    <Fragment slot="json-ld">
        <script type="application/ld+json" is:inline set:html={ld}></script>
    </Fragment>
    <div>
        <Fragment set:html={privacyMainBeforeContacts} />
        <OperatorContactList />
        <Fragment set:html={privacyMainAfterContacts} />
    </div>
</SiteLayout>
