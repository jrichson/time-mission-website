---
import SiteHead from '../components/SiteHead.astro';
import SiteNav from '../components/SiteNav.astro';
import MobileMenu from '../components/MobileMenu.astro';
import LocationOverlay from '../components/LocationOverlay.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TicketPanel from '../components/TicketPanel.astro';
import SiteScripts from '../components/SiteScripts.astro';
import { allLocations } from '../data/locations';
import { resolveLastUpdated } from '../lib/last-updated';
import { getPublishedSitePage, sitePageHeadForDoc } from '../lib/payload/load';

interface Props {
    canonicalPath: string;
    title?: string;
    description?: string;
    ogImage?: string;
    twitterImage?: string;
    robots?: string;
    bodyDataLocation?: string;
    bodyClass?: string;
    bookingCtaHref?: string;
    bookingCtaLabel?: string;
    bookingCtaIsBookingTrigger?: boolean;
    bookingCtaI18n?: string;
    landingHead?: import('../lib/seo/catalog').LandingHeadInput | null;
    lang?: string;
    /** Optional YYYY-MM-DD override; otherwise resolved from git mtime of the page source file. */
    lastUpdated?: string;
    /**
     * @deprecated No longer needed — SiteLayout derives the source path from canonicalPath.
     * Kept for backward compatibility; ignored if canonicalPath resolves the mtime correctly.
     */
    sourcePageUrl?: string;
}

const {
    title,
    description,
    canonicalPath,
    ogImage,
    twitterImage,
    robots,
    bodyDataLocation,
    bodyClass,
    bookingCtaHref = '#',
    bookingCtaLabel = 'Book Now',
    bookingCtaIsBookingTrigger = true,
    bookingCtaI18n = 'nav.bookNow',
    landingHead,
    lang = 'en',
    lastUpdated,
    sourcePageUrl,
} = Astro.props;

const lastUpdatedInfo = resolveLastUpdated({
    override: lastUpdated,
    canonicalPath,
    sourceFile: sourcePageUrl,
});
const sitePageHead = landingHead ? null : sitePageHeadForDoc(await getPublishedSitePage(canonicalPath));
const pageLocation = bodyDataLocation
    ? allLocations.find((loc) => loc.id === bodyDataLocation || loc.slug === bodyDataLocation)
    : null;
const loadsBriqWidget = pageLocation?.bookingProvider === 'briq' && !!pageLocation.briqWidget;
---

<!DOCTYPE html>
<html lang={lang}>
    <head>
        <SiteHead
            canonicalPath={canonicalPath}
            title={title}
            description={description}
            ogImage={ogImage}
            twitterImage={twitterImage}
            robots={robots}
            landingHead={landingHead ?? sitePageHead}
            lastUpdatedIso={lastUpdatedInfo.iso}
        />
        <slot name="head-extra" />
        {loadsBriqWidget && (
            <script language="javascript" is:inline>
                ;(function (d, t){
                    var s = d.createElement(t)
                    s.async = true
                    s.src = 'https://widgetcdn.briqbookings.com/widget/widget.js'
                    var r = d.getElementsByTagName(t)[0]
                    r.parentNode.insertBefore(s, r)
                })(document, 'script')
            </script>
        )}
        <slot name="page-style" />
        <slot name="json-ld" />
    </head>
    <body class={bodyClass} data-location={bodyDataLocation}>
        <a class="skip-link" href="#main">Skip to main content</a>
        <header role="banner">
            <slot name="pre-nav" />
            <slot name="nav">
                <MobileMenu
                    currentLang={lang}
                    bookingCtaHref={bookingCtaHref}
                    bookingCtaLabel={bookingCtaLabel}
                    bookingCtaIsBookingTrigger={bookingCtaIsBookingTrigger}
                    bookingCtaI18n={bookingCtaI18n}
                />
                <SiteNav
                    currentLang={lang}
                    bookingCtaHref={bookingCtaHref}
                    bookingCtaLabel={bookingCtaLabel}
                    bookingCtaIsBookingTrigger={bookingCtaIsBookingTrigger}
                    bookingCtaI18n={bookingCtaI18n}
                />
                <LocationOverlay currentLang={lang} />
            </slot>
        </header>
        <main id="main" tabindex="-1">
            <slot />
        </main>
        <footer role="contentinfo">
            <slot name="footer">
                <SiteFooter />
            </slot>
        </footer>
        <aside class="page-last-updated" aria-label="Page freshness">
            <time datetime={lastUpdatedInfo.iso}>{lastUpdatedInfo.human}</time>
        </aside>
        <TicketPanel pageLocationSlug={bodyDataLocation} />
        <SiteScripts />
        <slot name="after-site-scripts" />
    </body>
</html>

<style is:global>
    .page-last-updated {
        text-align: center;
        padding: 0.75rem 1rem 1.5rem;
        font-family: var(--body);
        font-size: 0.75rem;
        color: var(--white-soft);
        background: transparent;
    }
    .page-last-updated time { font-variant-numeric: tabular-nums; }
    @media (max-width: 480px) {
        .page-last-updated { padding: 0.5rem 1rem 1rem; font-size: 0.7rem; }
    }
</style>
