---
import SiteHead from '../components/SiteHead.astro';
import SiteNav from '../components/SiteNav.astro';
import MobileMenu from '../components/MobileMenu.astro';
import LocationOverlay from '../components/LocationOverlay.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TicketPanel from '../components/TicketPanel.astro';
import SiteScripts from '../components/SiteScripts.astro';
import LanguageSuggestion from '../components/LanguageSuggestion.astro';
import { allLocations } from '../data/locations';
import { resolveLastUpdated } from '../lib/last-updated';
import {
    announcementBannerViewForDoc,
    getPublishedAnnouncementBanners,
    getPublishedSitePage,
    selectAnnouncementBanner,
    sitePageHeadForDoc,
} from '../lib/payload/load';
import { activeSiteProfile } from '../lib/site-profile';

interface Props {
    canonicalPath: string;
    title?: string;
    description?: string;
    ogImage?: string;
    twitterImage?: string;
    robots?: string;
    ogType?: 'article' | 'website';
    publishedTime?: string;
    bodyDataLocation?: string;
    bodyClass?: string;
    bookingCtaHref?: string;
    bookingCtaLabel?: string;
    bookingCtaIsBookingTrigger?: boolean;
    bookingCtaI18n?: string;
    bookingCtaSignupFormId?: string;
    landingHead?: import('../lib/seo/catalog').LandingHeadInput | null;
    lang?: string;
    /** Optional YYYY-MM-DD override; otherwise resolved from git mtime of the page source file. */
    lastUpdated?: string;
}

const {
    title,
    description,
    canonicalPath,
    ogImage,
    twitterImage,
    robots,
    ogType,
    publishedTime,
    bodyDataLocation,
    bodyClass,
    bookingCtaHref = '#',
    bookingCtaLabel = 'Book Now',
    bookingCtaIsBookingTrigger = true,
    bookingCtaI18n = 'nav.bookNow',
    bookingCtaSignupFormId = '',
    landingHead,
    lang = activeSiteProfile.defaultLocale,
    lastUpdated,
} = Astro.props;

const lastUpdatedInfo = resolveLastUpdated({
    override: lastUpdated,
    canonicalPath,
});
const sitePageHead = landingHead ? null : sitePageHeadForDoc(await getPublishedSitePage(canonicalPath));
const pageLocation = bodyDataLocation
    ? allLocations.find((loc) => loc.id === bodyDataLocation || loc.slug === bodyDataLocation)
    : null;
const locationTickerI18n = activeSiteProfile.id === 'eu' && pageLocation?.region === 'europe'
    ? `ticker.location.${pageLocation.slug}`
    : '';
const announcementBanner = announcementBannerViewForDoc(
    selectAnnouncementBanner(await getPublishedAnnouncementBanners(), {
        locationSlug: pageLocation?.slug,
        region: pageLocation?.region,
    }),
);
const loadsBriqWidget = pageLocation?.bookingProvider === 'briq' && !!pageLocation.briqWidget;
const defaultGtmContainerId = activeSiteProfile.id === 'us' ? 'GTM-WQPWRNJB' : '';
const gtmContainerId = String(import.meta.env.PUBLIC_GTM_CONTAINER_ID || defaultGtmContainerId).trim();
const rendersGtmNoscript = activeSiteProfile.consentProfile === 'us_open' && Boolean(gtmContainerId);
---

<!DOCTYPE html>
<html lang={lang}>
    <head>
        <SiteHead
            canonicalPath={canonicalPath}
            title={title}
            description={description}
            ogImage={ogImage}
            twitterImage={twitterImage}
            robots={robots}
            ogType={ogType}
            publishedTime={publishedTime}
            landingHead={landingHead ?? sitePageHead}
            lastUpdatedIso={lastUpdatedInfo.iso}
        />
        <slot name="head-extra" />
        {loadsBriqWidget && <link rel="stylesheet" href="/css/briq-widget.css?v=2" />}
		{loadsBriqWidget && (
			<script is:inline>
				;(function (d, t){
					function loadBriqWidgetScript() {
						if (d.querySelector('script[data-briq-widget-script]')) return
						var s = d.createElement(t)
						s.async = true
						s.src = 'https://widgetcdn.briqbookings.com/widget/widget.js'
						s.setAttribute('data-briq-widget-script', '')
						s.addEventListener('load', function () {
							s.setAttribute('data-briq-widget-loaded', 'true')
							s.removeAttribute('data-briq-widget-error')
						}, { once: true })
						s.addEventListener('error', function () {
							s.setAttribute('data-briq-widget-error', 'true')
							s.removeAttribute('data-briq-widget-loaded')
						}, { once: true })
						var r = d.getElementsByTagName(t)[0]
						r.parentNode.insertBefore(s, r)
					}
                    if (d.readyState === 'loading') {
                        d.addEventListener('DOMContentLoaded', loadBriqWidgetScript, { once: true })
                    } else {
                        loadBriqWidgetScript()
                    }
                })(document, 'script')
            </script>
        )}
        <slot name="page-style" />
        <slot name="json-ld" />
    </head>
    <body class={bodyClass} data-location={bodyDataLocation}>
        <!-- Google Tag Manager (noscript) -->
        {rendersGtmNoscript ? (
            <noscript>
                <iframe
                    class="gtm-noscript-frame"
                    src={`https://www.googletagmanager.com/ns.html?id=${gtmContainerId}`}
                    height="0"
                    width="0"
                ></iframe>
            </noscript>
        ) : null}
        <!-- End Google Tag Manager (noscript) -->
        <a class="skip-link" href="#main">Skip to main content</a>
        <header role="banner">
            <slot name="nav">
                <MobileMenu
                    currentLang={lang}
                    bookingCtaHref={bookingCtaHref}
                    bookingCtaLabel={bookingCtaLabel}
                    bookingCtaIsBookingTrigger={bookingCtaIsBookingTrigger}
                    bookingCtaI18n={bookingCtaI18n}
                    bookingCtaSignupFormId={bookingCtaSignupFormId}
                />
                <SiteNav
                    currentLang={lang}
                    announcementBanner={announcementBanner}
                    bookingCtaHref={bookingCtaHref}
                    bookingCtaLabel={bookingCtaLabel}
                    bookingCtaIsBookingTrigger={bookingCtaIsBookingTrigger}
                    bookingCtaI18n={bookingCtaI18n}
                    bookingCtaSignupFormId={bookingCtaSignupFormId}
                    locationTicker={pageLocation?.ticker}
                    locationTickerI18n={locationTickerI18n}
                />
                <LocationOverlay currentLang={lang} />
            </slot>
        </header>
        <LanguageSuggestion />
        <main id="main" tabindex="-1">
            <slot />
        </main>
        <slot name="footer">
            <SiteFooter pageLocation={pageLocation} />
        </slot>
        <TicketPanel pageLocationSlug={bodyDataLocation} />
        <SiteScripts />
        <slot name="after-site-scripts" />
    </body>
</html>
