---
/**
 * Full-width footer matching the shared `footer-grid` page treatment.
 * Canonical site footer rendered by SiteLayout.
 */
import { allLocations, type LocationRecord } from '../data/locations';
import {
    locationsForRegion,
    locationListLabel,
    orderedLocationRegions,
} from '../lib/location-list';
import {
    locationAddressLines,
    locationContactHref,
    locationHoursRows,
    locationHref,
    locationHrefIsExternal,
    locationPhoneHref,
    locationStatusBadge,
} from '../lib/location-view';
import { isTmOpsContactFormLocation } from '../lib/contact-routing-policy.mjs';
import { activeSiteProfile } from '../lib/site-profile';

interface Props {
    pageLocation?: LocationRecord | null;
}

const year = new Date().getFullYear();
const { pageLocation = null } = Astro.props;

function contactHrefForLocation(loc: LocationRecord | null): string {
    if (!loc) return '/contact';
    if (isTmOpsContactFormLocation(loc.slug)) return locationContactHref(loc);
    const email = String(loc.contact.email || '').trim();
    if (email) return `mailto:${email}`;
    return locationContactHref(loc);
}

const contactHref = contactHrefForLocation(pageLocation);
const teamApplicationUrls: Record<string, string> = {
    manassas: 'https://app.connecteam.com/#/apply?link=ac7fa1ce-9e24-4c69-a1ef-bfdbc1bb2a54',
    'mount-prospect': 'https://app.connecteam.com/#/apply?link=1a51944c-ebf3-4927-9cdb-5f212e0210ba',
    'orland-park': 'https://app.connecteam.com/#/apply?link=027bf82b-de3d-4134-b151-fcb8ddbe84d5',
    nashville: 'https://app.connecteam.com/#/apply?link=7d0b94ee-d43c-461f-aad4-424e8544e699',
};
const teamApplicationUrl = pageLocation ? teamApplicationUrls[pageLocation.slug] || '' : '';
const footerRegionMetadata = {
    us: { i18n: 'location.unitedStates', label: 'United States' },
    europe: { i18n: 'location.europe', label: 'Europe' },
} as const;
const footerLocationGroups = orderedLocationRegions(activeSiteProfile.internalRegion).map((region) => ({
    ...footerRegionMetadata[region],
    locations: locationsForRegion(allLocations, region),
    region,
}));

function hoursFallbackForLocation(loc: LocationRecord | null): string {
    if (!loc) return '';
    return locationStatusBadge(loc) || 'Hours coming soon';
}

function hoursFallbackI18nForLocation(loc: LocationRecord | null): string {
    if (!loc) return '';
    const status = locationStatusBadge(loc);
    if (status === 'Coming Soon') return 'location.comingSoon';
    return status ? '' : 'location.hoursComingSoon';
}

function statusBadgeI18n(statusLabel: string): string | undefined {
    return statusLabel === 'Coming Soon' ? 'location.comingSoon' : undefined;
}

function euFooterI18nKey(loc: LocationRecord | null, prefix: string): string | undefined {
    if (activeSiteProfile.id !== 'eu' || loc?.region !== 'europe') return undefined;
    return `${prefix}.${loc.slug}`;
}

const footerLocationName = pageLocation ? pageLocation.shortName || pageLocation.name : '';
const footerAddressParts = locationAddressLines(pageLocation);
const footerPhone = String(pageLocation?.contact.phone || '').trim();
const footerPhoneHref = locationPhoneHref(pageLocation);
const footerHoursRows = locationHoursRows(pageLocation);
const footerHoursFallback = hoursFallbackForLocation(pageLocation);
const footerHoursFallbackI18n = hoursFallbackI18nForLocation(pageLocation);
const footerLocationNameI18n = euFooterI18nKey(pageLocation, 'footer.city');
const hasPageLocation = Boolean(pageLocation);
---

<footer class="footer">
    <div class="footer-grid">
        <div class="footer-brand">
            <a href="/" class="footer-brand-home" aria-label="Time Mission homepage" data-i18n-aria-label="footer.homeAria">
                <img src="/assets/logo/time-mission-logo-transparent.svg" alt="Time Mission logo" width="107" height="36" loading="lazy" decoding="async" />
            </a>
            <p data-i18n="footer.tagline">
                A social gaming adventure where teams compete through immersive challenges across time and space.
            </p>
            <div class="footer-social">
                <a href="https://www.instagram.com/timemission/" target="_blank" rel="noopener" aria-label="Instagram">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5">
                        <rect x="2" y="2" width="20" height="20" rx="5"></rect>
                        <circle cx="12" cy="12" r="4.5"></circle>
                        <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"></circle>
                    </svg>
                </a>
                <a href="https://www.tiktok.com/@timemissionhq" target="_blank" rel="noopener" aria-label="TikTok">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                        <path
                            d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1 0-5.78c.27 0 .54.04.8.1v-3.51a6.37 6.37 0 0 0-.8-.05A6.34 6.34 0 0 0 3.15 15.3a6.34 6.34 0 0 0 10.86 4.34A6.28 6.28 0 0 0 15.86 15V8.74a8.18 8.18 0 0 0 4.14 1.15V6.69h-.41z"
                        ></path>
                    </svg>
                </a>
                <a href="https://www.facebook.com/TimeMissionHQ/" target="_blank" rel="noopener" aria-label="Facebook">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                        <path
                            d="M24 12c0-6.627-5.373-12-12-12S0 5.373 0 12c0 5.99 4.388 10.954 10.125 11.854V15.47H7.078V12h3.047V9.356c0-3.007 1.792-4.668 4.533-4.668 1.312 0 2.686.235 2.686.235v2.953h-1.513c-1.49 0-1.956.927-1.956 1.874V12h3.328l-.532 3.47h-2.796v8.384C19.612 22.954 24 17.99 24 12z"
                        ></path>
                    </svg>
                </a>
            </div>
        </div>
        <div class="footer-column">
            <h3 class="footer-title" data-i18n="footer.experience">EXPERIENCE</h3>
            <ul class="footer-links">
                <li><a href="/" data-i18n="nav.home">Home</a></li>
                <li><a href="/about" data-i18n="nav.about">About</a></li>
                <li><a href="/missions" data-i18n="nav.missions">Missions</a></li>
                <li><a href="/groups" data-i18n="nav.groups">Groups</a></li>
                <li><a href="/gift-cards" data-i18n="nav.giftCards">Gift Cards</a></li>
                <li><a href="/faq" data-i18n="nav.faq">FAQ</a></li>
            </ul>
        </div>
        <div class="footer-column">
            <h3 class="footer-title" data-i18n="footer.info">INFO</h3>
            <ul class="footer-links">
                <li><a href={contactHref} data-i18n="location.contactUs">Contact Us</a></li>
                {teamApplicationUrl && (
                    <li>
                        <a href={teamApplicationUrl} target="_blank" rel="noopener" data-i18n="footer.joinTeam">
                            Join Our Team
                        </a>
                    </li>
                )}
                <li><a href="/press" data-i18n="footer.press">Press</a></li>
                <li data-tm-donation-link hidden><a href="/donation" data-i18n="footer.donation">Donation</a></li>
                <li><a href="/waiver" data-i18n="footer.waiver">Waiver</a></li>
                <li><a href="/licensing" data-i18n="footer.licensing">Licensing</a></li>
            </ul>
        </div>
        <div class="footer-column footer-locations-column">
            <h3 class="footer-locations-title" data-i18n={footerLocationNameI18n || (!hasPageLocation ? 'nav.locations' : undefined)}>
                {footerLocationName || 'LOCATIONS'}
            </h3>
            <div class="footer-locations-dropdown" hidden={hasPageLocation}>
                {footerLocationGroups.map((group) => (
                    <div class="footer-location-group" data-location-region={group.region}>
                        <button type="button" class="footer-location-toggle">
                            <span data-i18n={group.i18n}>{group.label}</span>
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M6 9l6 6 6-6"></path>
                            </svg>
                        </button>
                        <div class="footer-location-list">
                            {group.locations.map((loc) => {
                                const statusLabel = locationStatusBadge(loc);
                                return (
                                    <a
                                        href={locationHref(loc)}
                                        class={statusLabel ? 'coming-soon' : undefined}
                                        target={locationHrefIsExternal(loc) ? '_blank' : undefined}
                                        rel={locationHrefIsExternal(loc) ? 'noopener' : undefined}
                                    >
                                        <span data-i18n={euFooterI18nKey(loc, 'footer.location')}>{locationListLabel(loc)}</span>{' '}
                                        {statusLabel && <span class="coming-soon-tag" data-i18n={statusBadgeI18n(statusLabel)}>{statusLabel}</span>}
                                    </a>
                                );
                            })}
                        </div>
                    </div>
                ))}
            </div>
            <div class="footer-location-info" hidden={!hasPageLocation}>
                <div class="footer-loc-detail">
                    <span class="footer-loc-label" data-i18n="footer.address">Address</span>
                    <p class="footer-loc-address">
                        {footerAddressParts.map((part, index) => (
                            <>
                                {part}{index < footerAddressParts.length - 1 && <br />}
                            </>
                        ))}
                    </p>
                </div>
                <div class="footer-loc-detail">
                    <span class="footer-loc-label" data-i18n="footer.phone">Phone</span>
                    <a class="footer-loc-phone" href={footerPhoneHref || undefined} hidden={!footerPhone}>
                        {footerPhone || <span class="visually-hidden" data-i18n="footer.callSelected">Call your selected location</span>}
                    </a>
                    <p class="footer-loc-phone-note" hidden={Boolean(footerPhone)} data-i18n="location.phoneComingSoon">Phone coming soon</p>
                </div>
                <details class="footer-loc-hours-details">
                    <summary class="footer-loc-hours-summary">
                        <span data-i18n="location.hours">Hours</span>
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M6 9l6 6 6-6"></path>
                        </svg>
                    </summary>
                    <div class="footer-loc-hours">
                        {footerHoursRows.length ? (
                            footerHoursRows.map((row) => (
                                <div class="footer-hours-row">
                                    <span data-i18n={`footer.day.${row.day.slice(0, 3).toLowerCase()}`}>{row.day}</span>
                                    <span>{row.label}</span>
                                </div>
                            ))
                        ) : (
                            <div class="footer-hours-row footer-hours-row--note">
                                <span data-i18n="location.status">Status</span>
                                <span data-i18n={footerHoursFallbackI18n}>{footerHoursFallback}</span>
                            </div>
                        )}
                    </div>
                </details>
                <a class="footer-loc-map" href={pageLocation?.mapUrl || '#'} target="_blank" rel="noopener" hidden={!pageLocation?.mapUrl}>
                    <span data-i18n="location.getDirections">Get Directions ↗</span>
                </a>
                <button type="button" class="footer-loc-change" data-i18n="nav.changeLocation">Change Location</button>
            </div>
        </div>
    </div>

    <div class="footer-bottom">
        <p class="footer-copyright">
            &copy; {year} Time Mission. <span data-i18n="footer.rights">All rights reserved.</span>
            <span class="footer-developer-credit">
                <span aria-hidden="true"> &middot; </span><span data-i18n="footer.developedBy">Developed by</span>{' '}
                <a href="https://compatible.dev/">Compatible Dev</a>
            </span>
        </p>
        <div class="footer-legal">
            <a href="/terms" data-i18n="footer.terms">Terms</a>
            <a href="/privacy" data-i18n="footer.privacy">Privacy</a>
            <a href="/cookies" data-i18n="footer.cookies">Cookies</a>
            <a href="/code-of-conduct" data-i18n="footer.codeOfConduct">Code of Conduct</a>
            <a href="/accessibility" data-i18n="footer.accessibility">Accessibility</a>
            <a href="/licensing" data-i18n="footer.licensing">Licensing</a>
            <button type="button" class="footer-link-button" data-cc="show-preferencesModal" data-i18n="footer.cookiePreferences">
                Cookie Preferences
            </button>
        </div>
    </div>
</footer>
