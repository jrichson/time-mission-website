<aside class="language-suggestion" data-language-suggestion hidden aria-live="polite">
    <p data-language-suggestion-copy></p>
    <a class="language-suggestion-action" href="#" data-language-suggestion-link>View site</a>
    <button
        class="language-suggestion-dismiss"
        type="button"
        data-language-suggestion-dismiss
        aria-label="Dismiss language suggestion"
        title="Dismiss"
    >
        <span aria-hidden="true">&times;</span>
    </button>
</aside>
