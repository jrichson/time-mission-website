---
import LanguageSwitcher from './LanguageSwitcher.astro';
import nav from '../data/site/navigation.json';
import { megaMenus } from '../lib/mega-menus';

interface Props {
    currentLang?: string;
    bookingCtaHref?: string;
    bookingCtaLabel?: string;
    bookingCtaIsBookingTrigger?: boolean;
    bookingCtaI18n?: string;
    bookingCtaSignupFormId?: string;
    bookingCtaRollerCheckout?: { url: string; locationSlug: string } | null;
}

const {
    currentLang = 'en',
    bookingCtaHref = '#',
    bookingCtaLabel = 'Book Now',
    bookingCtaIsBookingTrigger = true,
    bookingCtaI18n = 'nav.bookNow',
    bookingCtaSignupFormId = '',
    bookingCtaRollerCheckout = null,
} = Astro.props;
const bookingCtaAttrs = {
    ...(bookingCtaIsBookingTrigger ? { 'data-tm-booking-trigger': '', 'data-tm-booking-kind': 'tickets' } : {}),
    ...(bookingCtaI18n ? { 'data-i18n': bookingCtaI18n } : {}),
    ...(bookingCtaSignupFormId ? { 'data-tm-klaviyo-form-trigger': bookingCtaSignupFormId } : {}),
    ...(bookingCtaRollerCheckout ? {
        'data-tm-roller-checkout': bookingCtaRollerCheckout.url,
        'data-tm-location': bookingCtaRollerCheckout.locationSlug,
    } : {}),
};

// Top level mirrors the desktop nav; everything else lives inside the expandable sections.
const mobileTopLevel = ['/about', '/missions', '/groups', '/faq'];

const navTranslationKeys: Record<string, string> = {
    '/': 'nav.home',
    '/about': 'nav.about',
    '/missions': 'nav.missions',
    '/groups': 'nav.groups',
    '/faq': 'nav.faq',
    '/gift-cards': 'nav.giftCards',
    '/locations': 'nav.locations',
    '/contact': 'nav.contact',
};
---

<!-- Full-Screen Mobile Menu -->
<div class="mobile-menu" id="mobileMenu">
    <ul class="mobile-menu-links">
        {nav.primary.filter((item) => mobileTopLevel.includes(item.href)).map((item) => {
            const mega = megaMenus[item.href];
            if (!mega) {
                return (
                    <li>
                        <a href={item.href} data-i18n={navTranslationKeys[item.href]}>{item.label}</a>
                    </li>
                );
            }
            return (
                <li class="mobile-menu-group">
                    <details name="mobile-menu-section">
                        <summary>
                            <span data-i18n={navTranslationKeys[item.href]}>{item.label}</span>
                            <svg class="mobile-menu-chevron" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6,9 12,15 18,9"></polyline></svg>
                        </summary>
                        <div class="mobile-mega">
                            <div class="mobile-mega-cards" data-mega-random={mega.viewAll ? '3' : undefined}>
                                {mega.cards.map((card, index) => (
                                    <a class="mobile-mega-card" href={card.href} hidden={mega.viewAll && index >= 3 ? true : undefined}>
                                        <img src={card.img} alt="" width="480" height="320" loading="lazy" decoding="async" />
                                        <span class="mobile-mega-card-copy">
                                            <span class="mobile-mega-card-title" data-i18n={card.i18n}>{card.title}</span>
                                            <span class="mobile-mega-card-text">{card.text}</span>
                                        </span>
                                    </a>
                                ))}
                                {mega.viewAll && (
                                    <a class="mobile-mega-card mobile-mega-card--all" href={mega.viewAll.href}>
                                        <img src={mega.viewAll.img} alt="" width="480" height="320" loading="lazy" decoding="async" />
                                        <span class="mobile-mega-card-copy">
                                            <span class="mobile-mega-card-title">{mega.viewAll.title} →</span>
                                            <span class="mobile-mega-card-text">{mega.viewAll.text}</span>
                                        </span>
                                    </a>
                                )}
                            </div>
                            <ul class="mobile-mega-links">
                                {mega.links.map((link) => (
                                    <li><a href={link.href} data-i18n={link.i18n}>{link.label}</a></li>
                                ))}
                            </ul>
                        </div>
                    </details>
                </li>
            );
        })}
    </ul>
    <div class="mobile-menu-language">
        <LanguageSwitcher currentLang={currentLang} placement="mobile" />
    </div>
    <div class="mobile-menu-socials">
        <a href="https://www.instagram.com/timemission/" target="_blank" rel="noopener" aria-label="Instagram">
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        </a>
        <a href="https://www.tiktok.com/@timemissionhq" target="_blank" rel="noopener" aria-label="TikTok">
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1 0-5.78 2.84 2.84 0 0 1 .51.05V8.97a6.34 6.34 0 0 0-.51-.02 6.34 6.34 0 1 0 6.34 6.34V9.87a8.16 8.16 0 0 0 3.76.92V7.35a4.85 4.85 0 0 1 0-.66z"></path></svg>
        </a>
        <a href="https://www.facebook.com/TimeMissionHQ/" target="_blank" rel="noopener" aria-label="Facebook">
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
        </a>
    </div>
    <div class="mobile-menu-cta">
        <a href={bookingCtaRollerCheckout?.url || bookingCtaHref} class="btn-tickets" {...bookingCtaAttrs}>{bookingCtaLabel}</a>
    </div>
</div>
