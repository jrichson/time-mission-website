---
import venues from '../../functions/_shared/leaderboard-locations.json';
import { allLocations } from '../data/locations';
interface Props {
    limit?: number;
    showViewAll?: boolean;
}
const { limit = 10, showViewAll = false } = Astro.props;
const locations = allLocations.filter(location => Object.hasOwn(venues, location.slug));
---

<div class="leaderboard" data-leaderboard data-limit={limit}>
    <div class="leaderboard-controls">
        <p class="leaderboard-scope" data-i18n="leaderboard.scope">Top 100 scores · Tied scores share a rank</p>
        <div class="leaderboard-filters">
            <label class="leaderboard-filter">
                <span class="visually-hidden" data-i18n="leaderboard.filterLocation">Location</span>
                <select data-leaderboard-location>
                    <option value="" disabled data-i18n="leaderboard.choose">Choose a venue</option>
                    <option value="global" selected data-i18n="leaderboard.global">Global · US venues</option>
                    {locations.map(location => <option value={location.slug} data-page-i18n="ignore">{location.shortName || location.name}</option>)}
                </select>
            </label>
            <label class="leaderboard-search">
                <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
                <span class="visually-hidden" data-i18n="leaderboard.searchLabel">Search loaded results</span>
                <input type="search" autocomplete="off" placeholder="Search loaded results" data-i18n-placeholder="leaderboard.searchPlaceholder" data-leaderboard-search />
            </label>
        </div>
    </div>
    <div class="leaderboard-card">
        <table class="leaderboard-table">
            <caption class="visually-hidden" data-leaderboard-caption tabindex="-1"></caption>
            <thead><tr>
                <th scope="col" class="lb-col-rank" aria-label="Rank" data-i18n-aria-label="leaderboard.position">#</th>
                <th scope="col" class="lb-col-team" data-i18n="leaderboard.team">Team</th>
                <th scope="col" class="lb-col-location" data-i18n="leaderboard.location">Venue</th>
                <th scope="col" class="lb-col-score" data-i18n="leaderboard.score">Score</th>
            </tr></thead>
            <tbody data-leaderboard-rows></tbody>
        </table>
        <p class="leaderboard-empty" role="status" aria-live="polite" data-leaderboard-status tabindex="-1" data-i18n="leaderboard.loading">Loading crew scores…</p>
        <button class="btn-secondary" type="button" data-leaderboard-retry hidden data-i18n="leaderboard.retry">Retry</button>
    </div>
    {!showViewAll && <div class="leaderboard-pagination" data-leaderboard-pagination hidden>
        <button type="button" class="btn-secondary" data-leaderboard-prev data-i18n="leaderboard.previous">Previous page</button>
        <span data-leaderboard-page></span>
        <button type="button" class="btn-secondary" data-leaderboard-next data-i18n="leaderboard.next">Next page</button>
    </div>}
    {showViewAll && <div class="leaderboard-cta">
        <a href="/leaderboard" class="btn-secondary" data-leaderboard-link data-i18n="leaderboard.viewAll">View Full Leaderboard</a>
    </div>}
</div>
