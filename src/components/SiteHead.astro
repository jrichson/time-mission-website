---
import analyticsLabels from '../data/site/analytics-labels.json';
import { getSeoForRoute, resolveLandingHeadSeo, type LandingHeadInput } from '../lib/seo/catalog';
import locationsData from '../../data/locations.json';

interface Props {
    canonicalPath: string;
    title?: string;
    description?: string;
    ogImage?: string;
    twitterImage?: string;
    robots?: string;
    /** When set (CMS landing pages), bypasses seo-routes.json for this canonicalPath */
    landingHead?: LandingHeadInput | null;
    /** ISO date string (YYYY-MM-DD) for <meta name="last-modified">. Resolved by SiteLayout. */
    lastUpdatedIso?: string;
}

const {
    canonicalPath,
    title: titleOverride,
    description: descOverride,
    ogImage: ogOverride,
    twitterImage: twOverride,
    robots: robotsOverride,
    landingHead,
    lastUpdatedIso,
} = Astro.props;

const seo = landingHead
    ? resolveLandingHeadSeo(canonicalPath, landingHead)
    : getSeoForRoute(canonicalPath);
const title = landingHead ? seo.title : titleOverride ?? seo.title;
const description = landingHead ? seo.description : descOverride ?? seo.description;
const canonicalUrl = seo.canonicalUrl;
const og = landingHead ? seo.ogImage : ogOverride ?? seo.ogImage;
const tw = landingHead ? seo.twitterImage : twOverride ?? seo.twitterImage;
const robotsValue = landingHead ? seo.robots : robotsOverride ?? seo.robots;
const siteAuthor = 'Ari Simon';
const siteDesigner = 'Jefferson Richardson';
const siteDeveloper = 'Converge Digital';

const gtmContainerId = String(import.meta.env.PUBLIC_GTM_CONTAINER_ID || 'GTM-WQPWRNJB').trim();
const sgtmContainerUrl = String(import.meta.env.PUBLIC_SGTM_CONTAINER_URL || '').trim().replace(/\/+$/, '');
const sgtmCollectPath = String(import.meta.env.PUBLIC_SGTM_COLLECT_PATH || '/g/collect').trim();

type ConsentProfile = 'eu_strict' | 'us_open' | 'global_strict';
type ConsentDefaults = {
    ad_storage: 'granted' | 'denied';
    analytics_storage: 'granted' | 'denied';
    ad_user_data: 'granted' | 'denied';
    ad_personalization: 'granted' | 'denied';
    functionality_storage: 'granted';
    security_storage: 'granted';
    wait_for_update: number;
};

const locationEntries = ((locationsData as { locations?: Array<{ slug?: string; region?: string }> }).locations || []);
const pathRegionMap = new Map<string, string>();
for (const entry of locationEntries) {
    if (!entry?.slug || !entry?.region) continue;
    pathRegionMap.set(`/${entry.slug}`, String(entry.region));
}
const currentRegion = pathRegionMap.get(canonicalPath) || '';
const consentProfile: ConsentProfile =
    currentRegion === 'europe' ? 'eu_strict' : currentRegion === 'us' ? 'us_open' : 'global_strict';

const consentDefaults: ConsentDefaults =
    consentProfile === 'us_open'
        ? {
              ad_storage: 'granted',
              analytics_storage: 'granted',
              ad_user_data: 'granted',
              ad_personalization: 'granted',
              functionality_storage: 'granted',
              security_storage: 'granted',
              wait_for_update: 500,
          }
        : {
              ad_storage: 'denied',
              analytics_storage: 'denied',
              ad_user_data: 'denied',
              ad_personalization: 'denied',
              functionality_storage: 'granted',
              security_storage: 'granted',
              wait_for_update: 500,
          };
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<script is:inline define:vars={{ analyticsLabels }}>window.__TM_ANALYTICS_LABELS__ = analyticsLabels;</script>
<script is:inline define:vars={{ gtmContainerId, sgtmContainerUrl, sgtmCollectPath, consentDefaults, consentProfile }}>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
        dataLayer.push(arguments);
    }
    window.gtag = gtag;
    window.__TM_CONSENT_STATE__ = Object.assign({}, consentDefaults);
    gtag('consent', 'default', consentDefaults);
    // Optional server-side GTM metadata for container-side routing decisions.
    window.__TM_TAGGING_CONFIG__ = {
        web_container_id: gtmContainerId || '',
        sgtm_container_url: sgtmContainerUrl || '',
        sgtm_collect_path: sgtmCollectPath || '/g/collect',
        mode: sgtmContainerUrl ? 'web_and_sgtm' : 'web_only',
        consent_profile: consentProfile,
    };
    dataLayer.push({
        event: 'tm_tagging_config',
        tagging_mode: window.__TM_TAGGING_CONFIG__.mode,
        tagging_server_url: window.__TM_TAGGING_CONFIG__.sgtm_container_url,
        tagging_server_collect_path: window.__TM_TAGGING_CONFIG__.sgtm_collect_path,
        web_gtm_container_id: window.__TM_TAGGING_CONFIG__.web_container_id,
        consent_profile: window.__TM_TAGGING_CONFIG__.consent_profile,
    });
</script>
<!-- Google Tag Manager -->
{gtmContainerId ? (
    <script is:inline define:vars={{ gtmContainerId }}>
        (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            var f = d.getElementsByTagName(s)[0],
                j = d.createElement(s),
                dl = l != 'dataLayer' ? '&l=' + l : '';
            j.async = true;
            j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
            f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', gtmContainerId);
    </script>
) : null}
<!-- End Google Tag Manager -->
<title>{title}</title>
<!-- SEO META -->
<meta name="description" content={description} />
<meta name="author" content={siteAuthor} />
<meta name="designer" content={siteDesigner} />
<meta name="developer" content={siteDeveloper} />
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content={robotsValue} />
{lastUpdatedIso ? <meta name="last-modified" content={lastUpdatedIso} /> : null}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={seo.siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={og} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={tw} />
<link rel="icon" type="image/png" href="/assets/logo/TM_Favicon.png" />
<link rel="preload" as="font" href="/assets/fonts/BebasNeue-Regular.woff2" type="font/woff2" crossorigin />
<link rel="preload" as="font" href="/assets/fonts/DMSans-Normal.woff2" type="font/woff2" crossorigin />
<link rel="preload" as="font" href="/assets/fonts/MonumentExtended-Regular.otf" type="font/otf" crossorigin />
<link rel="preload" as="font" href="/assets/fonts/MonumentExtended-Ultrabold.otf" type="font/otf" crossorigin />
<link rel="stylesheet" href="/css/variables.css" />
<link rel="stylesheet" href="/css/base.css" />
<link rel="stylesheet" href="/css/nav.css?v=22" />
<link rel="stylesheet" href="/css/footer.css?v=5" />
<link rel="stylesheet" href="/css/newsletter.css?v=4" />
<link rel="stylesheet" href="/css/ticket-panel.css?v=2" />
