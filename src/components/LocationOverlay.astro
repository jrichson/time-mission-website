---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { allLocations } from '../data/locations';
import {
    locationsForRegion,
    locationListLabel,
    orderedLocationRegions,
} from '../lib/location-list';
import { locationHref, locationHrefIsExternal, locationStatusBadge } from '../lib/location-view';
import { activeSiteProfile } from '../lib/site-profile';

interface Props {
    currentLang?: string;
}

const { currentLang = 'en' } = Astro.props;
const regionMetadata = {
    us: { i18n: 'location.unitedStates', label: 'United States' },
    europe: { i18n: 'location.europe', label: 'Europe' },
} as const;
const locationGroups = orderedLocationRegions(activeSiteProfile.internalRegion).map((region) => ({
    ...regionMetadata[region],
    locations: locationsForRegion(allLocations, region),
    region,
}));

function statusLabel(loc: (typeof allLocations)[number]) {
    return locationStatusBadge(loc) || 'Coming Soon';
}

function showsOpenNowBadge(loc: (typeof allLocations)[number]) {
    // Keep selector callouts intentionally scarce. Generic location status belongs
    // on the location page; the overlay only promotes these approved exceptions.
    const openNowLocations = activeSiteProfile.id === 'eu'
        ? ['brussels']
        : ['philadelphia', 'brussels'];
    return openNowLocations.includes(loc.slug) && loc.status === 'open';
}

function selectorBadge(loc: (typeof allLocations)[number]) {
    if (activeSiteProfile.id === 'us' && loc.slug === 'philadelphia' && loc.status === 'open') {
        return 'NOW OPEN';
    }
    if (showsOpenNowBadge(loc)) return 'OPEN NOW!';
    if (loc.status === 'temporarily-closed'
        && (activeSiteProfile.id === 'us' || loc.region === 'europe')) {
        return statusLabel(loc);
    }
    return '';
}

function selectorBadgeI18n(loc: (typeof allLocations)[number]) {
    if (loc.slug === 'philadelphia' && showsOpenNowBadge(loc)) return 'location.nowOpen';
    if (showsOpenNowBadge(loc)) return 'location.openNow';
    return undefined;
}

function statusClass(loc: (typeof allLocations)[number]) {
    if (showsOpenNowBadge(loc)) return 'location-open-now';
    if (loc.status === 'coming-soon') return 'location-coming-soon';
    if (loc.status === 'temporarily-closed') return 'location-temporarily-closed';
    return undefined;
}

function locationLabelI18n(loc: (typeof allLocations)[number]) {
    return loc.region === 'europe' ? `footer.location.${loc.slug}` : undefined;
}
---

<!-- Full-screen Location Overlay -->
<div class="location-dropdown" id="locationDropdown">
    <div class="location-dropdown-header">
        <a href="/" class="location-dropdown-logo">
            <img src="/assets/logo/time-mission-logo-transparent.svg" alt="Time Mission logo" width="107" height="36" />
        </a>
        <div class="location-dropdown-controls">
            <LanguageSwitcher currentLang={currentLang} placement="overlay" />
            <button class="location-dropdown-close" aria-label="Close" data-i18n-aria-label="location.close">&times;</button>
        </div>
    </div>
    <div class="location-dropdown-title" data-i18n="location.title">Select Your Location</div>
    <div class="location-overlay-body">
        <div class="location-overlay-left">
            {locationGroups.map((group) => (
                <div class="location-group" data-location-region={group.region}>
                    <div class="location-group-title" data-i18n={group.i18n}>{group.label}</div>
                    {group.locations.map((loc) => {
                    const badge = selectorBadge(loc);
                    const externalLocationHref = locationHrefIsExternal(loc);
                    return (
                    <a
                        href={locationHref(loc)}
                        data-city={loc.shortName}
                        data-tm-location-slug={loc.slug}
                        data-tm-external-location={externalLocationHref ? 'true' : undefined}
                        class={statusClass(loc)}
                        target={externalLocationHref ? '_blank' : undefined}
                        rel={externalLocationHref ? 'noopener' : undefined}
                    >
                        <span data-i18n={locationLabelI18n(loc)}>{locationListLabel(loc)}</span>
                        {badge && (
                            <span class="coming-soon-tag" data-i18n={selectorBadgeI18n(loc)}>
                                {' '}{badge}
                            </span>
                        )}
                    </a>
                    );
                    })}
                </div>
            ))}
        </div>
        <div class="location-overlay-divider"></div>
        <div class="location-overlay-right" id="locationInfo">
            <div class="location-map" id="locationMap"></div>
            <div class="location-info-content">
                <div class="location-info-empty">
                    <svg aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    <p data-i18n="location.empty">Select a location to view details</p>
                </div>
                <div class="location-info-details" hidden>
                    <h3 class="location-info-name"></h3>
                    <a href="#" class="location-info-address" target="_blank" rel="noopener">
                        <span class="location-info-directions" data-i18n="location.getDirections">Get Directions ↗</span>
                    </a>
                    <div class="location-info-phone"></div>
                    <div class="location-info-section">
                        <h4 data-i18n="location.hours">Hours</h4>
                        <div class="location-info-hours"></div>
                    </div>
                    <div class="location-info-actions">
                        <a href="#" class="location-info-book">Book Now</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="location-overlay-footer">
        <div class="location-overlay-social">
            <a href="https://www.instagram.com/timemission/" target="_blank" rel="noopener" aria-label="Instagram">
                <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5"></rect><circle cx="12" cy="12" r="4.5"></circle><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"></circle></svg>
            </a>
            <a href="https://www.tiktok.com/@timemissionhq" target="_blank" rel="noopener" aria-label="TikTok">
                <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1 0-5.78c.27 0 .54.04.8.1v-3.51a6.37 6.37 0 0 0-.8-.05A6.34 6.34 0 0 0 3.15 15.3a6.34 6.34 0 0 0 10.86 4.34A6.28 6.28 0 0 0 15.86 15V8.74a8.18 8.18 0 0 0 4.14 1.15V6.69h-.41z"></path></svg>
            </a>
            <a href="https://www.facebook.com/TimeMissionHQ/" target="_blank" rel="noopener" aria-label="Facebook">
                <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M24 12c0-6.627-5.373-12-12-12S0 5.373 0 12c0 5.99 4.388 10.954 10.125 11.854V15.47H7.078V12h3.047V9.356c0-3.007 1.792-4.668 4.533-4.668 1.312 0 2.686.235 2.686.235v2.953h-1.513c-1.49 0-1.956.927-1.956 1.874V12h3.328l-.532 3.47h-2.796v8.384C19.612 22.954 24 17.99 24 12z"></path></svg>
            </a>
        </div>
        <p class="location-overlay-copyright">
            &copy; 2026 Time Mission. <span data-i18n="footer.rights">All rights reserved.</span>
        </p>
    </div>
</div>
