---
import EducatorOffer from './EducatorOffer.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { definePage } from '../lib/define-page';
import { buildSimpleGraph, serializeGraph } from '../lib/schema/graph';

interface Props {
    formId: string;
    locationName: string;
    locationSlug: string;
}

const { formId, locationName, locationSlug } = Astro.props;
const page = definePage({ canonicalPath: `/${locationSlug}/educators` });
const ld = serializeGraph(buildSimpleGraph([
    { label: 'Home', href: '/' },
    { label: locationName, href: `/${locationSlug}` },
    { label: 'Educators Free Through September 30', href: page.canonicalPath },
]));
---

<SiteLayout
    canonicalPath={page.canonicalPath}
    bodyClass="has-noise tm-promo-page"
    bodyDataLocation={locationSlug}
>
    <Fragment slot="head-extra">
        <link rel="stylesheet" href="/css/page-promo.css?v=1" />
        <script
            is:inline
            async
            src="https://static.klaviyo.com/onsite/js/klaviyo.js?company_id=TNQysU"
        ></script>
    </Fragment>
    <Fragment slot="json-ld">
        <script type="application/ld+json" is:inline set:html={ld}></script>
    </Fragment>

    <EducatorOffer
        formId={formId}
        locationName={locationName}
        locationSlug={locationSlug}
    />
</SiteLayout>
