---
import { KLAVIYO_ACCOUNTS, klaviyoFormConfig } from '../../functions/_shared/klaviyo-forms.mjs';

interface Props {
    formId: string;
    formName: string;
}

const { formId, formName } = Astro.props;
const config = klaviyoFormConfig(formId);
if (!config) {
    throw new Error(`Klaviyo form ${formId} needs a backup entry in functions/_shared/klaviyo-forms.mjs`);
}
type BackupField = {
    name: string;
    label: string;
    type: 'text' | 'email' | 'tel';
    autocomplete?: string;
    required?: boolean;
};
const fields = config.fields as BackupField[];
const fieldId = (name: string) => `klaviyo-backup-${formId}-${name}`;
const klaviyoCompany = KLAVIYO_ACCOUNTS[config.site as 'us' | 'eu'];
---

<div
    class="tm-klaviyo-embed"
    data-tm-klaviyo-embed={formId}
    data-tm-klaviyo-company={klaviyoCompany}
>
    <script is:inline define:vars={{ klaviyoCompany }}>
        // Start Klaviyo as early as a head tag would, and record whether it loads or is blocked.
        (function () {
            if (window.__tmKlaviyo) return;
            var record = window.__tmKlaviyo = { state: 'loading' };
            var script = document.createElement('script');
            function settle(state) {
                record.state = state;
                document.dispatchEvent(new CustomEvent('tm:klaviyo-script', { detail: state }));
            }
            script.async = true;
            script.src = 'https://static.klaviyo.com/onsite/js/klaviyo.js?company_id=' + klaviyoCompany;
            script.onload = function () { settle('loaded'); };
            script.onerror = function () { settle('failed'); };
            document.head.appendChild(script);
        })();
    </script>
    <p class="tm-klaviyo-embed__loading" data-tm-klaviyo-loading role="status" hidden>Loading sign-up form…</p>
    <div
        class={`klaviyo-form-${formId}`}
        data-klaviyo-form-embed
        data-tm-form-name={formName}
        data-tm-klaviyo-form-id={formId}
    ></div>
    <form
        class="tm-klaviyo-backup"
        method="POST"
        action="/api/klaviyo-signup"
        data-tm-klaviyo-backup={formId}
        hidden
    >
        <input type="hidden" name="klaviyo_form_id" value={formId} />
        <p class="visually-hidden">
            <label>Do not fill this out if you are human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>
        {config.image && (
            <img
                class="tm-klaviyo-backup__image"
                src={config.image.src}
                srcset={config.image.srcset}
                sizes="(max-width: 700px) 90vw, 560px"
                width={config.image.width}
                height={config.image.height}
                alt={config.image.alt}
                loading="lazy"
                decoding="async"
            />
        )}
        {config.intro && <p class="tm-klaviyo-backup__intro">{config.intro}</p>}
        <div class="tm-klaviyo-backup__fields">
            {fields.map((field) => (
                <label class="tm-klaviyo-backup__field" for={fieldId(field.name)}>
                    <span class="tm-klaviyo-backup__label">{field.label}{field.required ? ' *' : ''}</span>
                    <input
                        id={fieldId(field.name)}
                        name={field.name}
                        type={field.type}
                        autocomplete={field.autocomplete || 'off'}
                        required={field.required || undefined}
                        inputmode={field.type === 'tel' ? 'tel' : undefined}
                    />
                </label>
            ))}
        </div>
        <p class="tm-klaviyo-backup__consent">
            {config.consent} <a href="/privacy">Privacy Policy</a> &amp; <a href="/terms">Terms</a>.
        </p>
        <div class="tm-klaviyo-backup__turnstile" data-tm-klaviyo-turnstile></div>
        <button type="submit" class="btn-primary tm-klaviyo-backup__submit">{config.submitLabel}</button>
        <p class="tm-klaviyo-backup__status" role="status" aria-live="polite"></p>
    </form>
    <div class="tm-klaviyo-backup__success" data-tm-klaviyo-backup-success hidden>
        <p class="tm-klaviyo-backup__success-title">{config.success.title}</p>
        <p>{config.success.text}</p>
    </div>
</div>
<script is:inline src="/js/klaviyo-fallback.js?v=5" defer></script>
