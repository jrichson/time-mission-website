---
import GroupInquiryForm from './GroupInquiryForm.astro';
import PromoSplit from './PromoSplit.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { definePage } from '../lib/define-page';
import { formLabelFor } from '../lib/group-form-context';
import { buildSimpleGraph, serializeGraph } from '../lib/schema/graph';

interface Props {
    // Only locations with an on-site group form (GROUP_INQUIRY_LOCATION_SLUGS).
    location: {
        name: string;
        slug: string;
    };
}

const { location } = Astro.props;
const page = definePage({ canonicalPath: `/${location.slug}/holiday-party` });
const ld = serializeGraph(buildSimpleGraph([
    { label: 'Home', href: '/' },
    { label: location.name, href: `/${location.slug}` },
    { label: 'Holiday Parties', href: page.canonicalPath },
]));
---

<SiteLayout
    canonicalPath={page.canonicalPath}
    bodyClass="has-noise tm-promo-page tm-holiday-party-page"
    bodyDataLocation={location.slug}
>
    <Fragment slot="head-extra">
        <link rel="stylesheet" href="/css/page-promo.css?v=10" />
        <link rel="stylesheet" href="/css/page-group-inquiry.css?v=3" />
    </Fragment>
    <Fragment slot="json-ld">
        <script type="application/ld+json" is:inline set:html={ld}></script>
    </Fragment>

    <PromoSplit
        backLink={{ href: `/${location.slug}`, label: location.name }}
        eyebrow={`${location.name} · Holiday Parties`}
        imageAlt="Next level holiday party: book and get $100 in gift cards, shown with a fan of $20 Time Mission gift cards"
        imagePosition="center"
        imageSrc="/assets/photos/promos/holiday-party-lets-play-1202.webp"
        imageSrcSet="/assets/photos/promos/holiday-party-lets-play-480.webp 480w, /assets/photos/promos/holiday-party-lets-play-800.webp 800w, /assets/photos/promos/holiday-party-lets-play-1202.webp 1202w"
    >
        <h1 id="promo-title" class="tm-promo-landing__title tm-promo-landing__title--holiday">
            <span>Take Your Holiday Party</span>{' '}
            <span>to the Next Level</span>
        </h1>

        <div class="tm-promo-landing__copy">
            <p class="tm-promo-landing__subhead">Book for 20+ guests and get $100 in gift cards</p>
            <p>Coworkers, friends, family, or the whole crew. Team up, take on the challenges, and celebrate the season with a party everyone will actually talk about. Book by Nov 19 and we'll add five $20 gift cards to share, reward, or save for your next mission.</p>
        </div>

        <div class="tm-promo-landing__rule" aria-hidden="true"></div>

        <a class="tm-promo-landing__cta" href="#group-inquiry" data-tm-promo-cta="holiday_party_inquire">
            Plan Your Party
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 5v14M5 12l7 7 7-7"></path>
            </svg>
        </a>
    </PromoSplit>

    <GroupInquiryForm
        formKey="holidays"
        formLabel={formLabelFor('holidays')}
        locationName={location.name}
        locationSlug={location.slug}
        embedded
    />

    <section class="tm-promo-fine-print" aria-label="Offer terms">
        <p class="tm-promo-landing__terms">*Offer valid for new holiday party bookings of 20 or more paid guests made by 11/19/26 for events held by 12/31/26. Five $20 Time Mission gift cards ($100 total value) will be issued to the event organizer after the event is completed. Gift cards are valid only for a future visit after the event date and cannot be applied to the holiday party booking. Limit one $20 gift card per visit; gift cards cannot be combined with each other or with any other offers, discounts, or promotions. Gift cards are valid only at the booking location and expire 3/31/27. Limit one offer per booking. Not valid on existing bookings. Gift cards have no cash value and are not redeemable for cash. Canceled or rescheduled events outside the offer window are not eligible. Time Mission reserves the right to modify or end this offer at any time.</p>
    </section>

    <Fragment slot="after-site-scripts">
        <script is:inline src="/js/group-inquiry-form.js?v=4"></script>
        <script is:inline async defer src="https://hcaptcha.com/1/api.js"></script>
    </Fragment>
</SiteLayout>
