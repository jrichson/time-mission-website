---
import { getPublicSiteContract } from '../lib/site-contract';
import locationsData from '../../data/locations.json';

const siteContract = getPublicSiteContract();
const tmData = locationsData;
const formConfig = {
    turnstileSiteKey: String(import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '').trim(),
};
---

<script is:inline define:vars={{ siteContract }}>
    window.__TM_SITE_CONTRACT__ = siteContract;
</script>
<script is:inline define:vars={{ tmData }}>
    window.TM_DATA = tmData;
</script>
<script is:inline define:vars={{ formConfig }}>
    window.__TM_FORM_CONFIG__ = formConfig;
</script>
<script defer is:inline src="/js/site-progressive.js?v=1"></script>
<script defer is:inline src="/js/consent-bridge.js?v=1"></script>
<script defer is:inline src="/js/analytics.js?v=1"></script>
<script defer is:inline src="/js/contact-form-analytics.js?v=1"></script>
<script defer is:inline src="/js/form-protection.js?v=1"></script>
<script defer is:inline src="/js/nav.js?v=4"></script>
<script defer is:inline src="/js/locations.js?v=10"></script>
<script defer is:inline src="/js/booking-controller.js?v=2"></script>
<script defer is:inline src="/js/ticket-panel.js?v=5"></script>
<script defer is:inline src="/js/a11y.js"></script>
<link rel="stylesheet" href="/css/cookieconsent.css">
<link rel="stylesheet" href="/css/cookie-consent.css">
<script defer is:inline src="/js/cookieconsent.umd.js"></script>
<script defer is:inline src="/js/cookie-consent.js?v=1"></script>
<script defer is:inline src="/js/web-vitals.iife.js"></script>
<script defer is:inline src="/js/web-vitals-rum.js?v=1"></script>
