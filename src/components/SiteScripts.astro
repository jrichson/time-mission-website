---
import { getPublicSiteContract } from '../lib/site-contract';
import i18nConfig from '../data/site/i18n.json';

const siteContract = getPublicSiteContract();
const formConfig = {
    turnstileSiteKey: String(import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '').trim(),
};
---

<script is:inline define:vars={{ siteContract }}>
    window.__TM_SITE_CONTRACT__ = siteContract;
</script>
<script is:inline define:vars={{ formConfig }}>
    window.__TM_FORM_CONFIG__ = formConfig;
    window.__TM_DATA_URL__ = '/data/locations.json';
    window.__TM_I18N_URL__ = '/data/i18n.json';
</script>
<script is:inline define:vars={{ i18nConfig }}>
    window.__TM_I18N__ = i18nConfig;
</script>
<script defer is:inline src="/js/site-progressive.js?v=1"></script>
<script defer is:inline src="/js/language-switcher.js?v=1"></script>
<script defer is:inline src="/js/consent-bridge.js?v=1"></script>
<script defer is:inline src="/js/analytics.js?v=1"></script>
<script defer is:inline src="/js/locations.js?v=14"></script>
<script defer is:inline src="/js/nav.js?v=8"></script>
<script defer is:inline src="/js/booking-controller.js?v=6"></script>
<script defer is:inline src="/js/ticket-panel.js?v=6"></script>
<script defer is:inline src="/js/a11y.js"></script>
<script is:inline>
    (function () {
        function scheduleIdle(callback, timeout) {
            if ('requestIdleCallback' in window) {
                window.requestIdleCallback(callback, { timeout: timeout || 1800 });
            } else {
                window.setTimeout(callback, Math.min(timeout || 1200, 1200));
            }
        }
        function getProfile() {
            try {
                return (window.__TM_TAGGING_CONFIG__ || {}).consent_profile || 'global_strict';
            } catch (e) {
                return 'global_strict';
            }
        }
        function appendStyle(href) {
            if (document.querySelector('link[href="' + href + '"]')) return;
            var link = document.createElement('link');
            link.rel = 'stylesheet';
            link.href = href;
            document.head.appendChild(link);
        }
        function appendScript(src, onload) {
            if (document.querySelector('script[src="' + src + '"]')) {
                if (onload) onload();
                return;
            }
            var script = document.createElement('script');
            script.src = src;
            script.defer = true;
            if (onload) script.addEventListener('load', onload, { once: true });
            document.body.appendChild(script);
        }
        function loadConsentUi() {
            if (getProfile() === 'us_open') return;
            appendStyle('/css/cookieconsent.css');
            appendStyle('/css/cookie-consent.css');
            appendScript('/js/cookieconsent.umd.js', function () {
                appendScript('/js/cookie-consent.js?v=1');
            });
        }
        function schedule() {
            if ('requestIdleCallback' in window) {
                window.requestIdleCallback(loadConsentUi, { timeout: 2200 });
            } else {
                window.setTimeout(loadConsentUi, 1200);
            }
        }
        if (document.readyState === 'complete') schedule();
        else window.addEventListener('load', schedule, { once: true });

        scheduleIdle(function () {
            var path = window.location.pathname || '';
            if (document.querySelector('form.contact-form') || path.indexOf('contact-thank-you') !== -1) {
                appendScript('/js/contact-form-analytics.js?v=1');
            }
            if (
                window.__TM_FORM_CONFIG__ &&
                window.__TM_FORM_CONFIG__.turnstileSiteKey &&
                document.querySelector('[data-tm-turnstile]')
            ) {
                appendScript('/js/form-protection.js?v=1');
            }
        }, 1400);

        scheduleIdle(function () {
            appendScript('/js/web-vitals.iife.js', function () {
                appendScript('/js/web-vitals-rum.js?v=1');
            });
        }, 2500);
    })();
</script>
