---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { activeSiteProfile } from '../lib/site-profile';

interface Props {
    announcementBanner?: {
        message: string;
        messageI18n?: string | null;
        tickerBehavior?: 'auto' | 'static' | 'animated' | null;
        startsAt?: string | null;
        endsAt?: string | null;
        linkLabel?: string | null;
        linkLabelI18n?: string | null;
        linkUrl?: string | null;
    } | null;
    currentLang?: string;
    bookingCtaHref?: string;
    bookingCtaLabel?: string;
    bookingCtaIsBookingTrigger?: boolean;
    bookingCtaI18n?: string;
    bookingCtaSignupFormId?: string;
    bookingCtaRollerCheckout?: { url: string; locationSlug: string } | null;
    locationTicker?: string;
    locationTickerI18n?: string;
}

const {
    announcementBanner = null,
    currentLang = 'en',
    bookingCtaHref = '#',
    bookingCtaLabel = 'Book Now',
    bookingCtaIsBookingTrigger = true,
    bookingCtaI18n = 'nav.bookNow',
    bookingCtaSignupFormId = '',
    bookingCtaRollerCheckout = null,
    locationTicker = '',
    locationTickerI18n = '',
} = Astro.props;
const bookingCtaAttrs = {
    ...(bookingCtaIsBookingTrigger ? { 'data-tm-booking-trigger': '', 'data-tm-booking-kind': 'tickets' } : {}),
    ...(bookingCtaI18n ? { 'data-i18n': bookingCtaI18n } : {}),
    ...(bookingCtaSignupFormId ? { 'data-tm-klaviyo-form-trigger': bookingCtaSignupFormId } : {}),
    ...(bookingCtaRollerCheckout ? {
        'data-tm-roller-checkout': bookingCtaRollerCheckout.url,
        'data-tm-location': bookingCtaRollerCheckout.locationSlug,
    } : {}),
};

type TickerMessage =
    | { text: string; href?: string | null; linkLabel?: string | null; linkLabelI18n?: string; textI18n?: string }
    | { label: string; date: string; separator?: string; labelI18n?: string; dateI18n?: string };
type TickerBehavior = 'auto' | 'static' | 'animated';

const tickerBaseMessages: TickerMessage[] = activeSiteProfile.id === 'eu'
    ? [{
        text: 'EINDHOVEN NOW OPEN!',
        textI18n: 'ticker.eindhovenNowOpen',
    }]
    : [];
const tickerCycles = 8;

function tickerMessageFromText(text: string, textI18n = ''): TickerMessage | null {
    const value = text.trim();
    if (value.includes('|')) {
        const [label, ...rest] = value.split('|').map((part) => part.trim()).filter(Boolean);
        if (label && rest.length) return { label, date: rest.join(' | '), separator: '|' };
    }
    const match = value.match(/^(.*?\bGRAND OPENING)\s*(?:[-–—]\s*)?(.+)$/i);
    if (match) return { label: match[1].trim(), date: match[2].trim() };
    return value ? { text: value, textI18n } : null;
}

function tickerMessageCanBeStatic(message: TickerMessage | null): boolean {
    return Boolean(message && 'text' in message && !message.href && message.text.length <= 28);
}

function tickerBehavior(value: string | null | undefined): TickerBehavior {
    if (value === 'static' || value === 'animated') return value;
    return 'auto';
}

const locationTickerMessage = tickerMessageFromText(locationTicker, locationTickerI18n);
const cmsAnnouncementMessage: TickerMessage | null = announcementBanner?.message
    ? {
        text: announcementBanner.message,
        textI18n: announcementBanner.messageI18n || undefined,
        href: announcementBanner.linkUrl,
        linkLabel: announcementBanner.linkLabel,
        linkLabelI18n: announcementBanner.linkLabelI18n || undefined,
    }
    : null;
const activeTickerMessage = cmsAnnouncementMessage || locationTickerMessage;
const activeTickerBehavior = cmsAnnouncementMessage ? tickerBehavior(announcementBanner?.tickerBehavior) : 'auto';
const tickerSource = cmsAnnouncementMessage ? 'cms' : locationTickerMessage ? 'location' : 'default';
const tickerIsStatic = Boolean(
    activeTickerMessage &&
    (
        activeTickerBehavior === 'static' ||
        (activeTickerBehavior === 'auto' && tickerMessageCanBeStatic(activeTickerMessage))
    ),
);
const tickerMessages: TickerMessage[] = activeSiteProfile.id === 'us' ? [] : activeTickerMessage
    ? tickerIsStatic
        ? [activeTickerMessage]
        : Array.from({ length: tickerCycles }, () => activeTickerMessage)
    : Array.from({ length: tickerCycles }, () => tickerBaseMessages).flat();
const fallbackTickerMessage = locationTickerMessage || tickerBaseMessages[0] || null;
const fallbackTickerText = locationTicker || (fallbackTickerMessage && 'text' in fallbackTickerMessage
    ? fallbackTickerMessage.text
    : '');
const fallbackTickerI18n = locationTickerI18n || (fallbackTickerMessage && 'text' in fallbackTickerMessage
    ? fallbackTickerMessage.textI18n || ''
    : '');
const fallbackTickerBehavior: TickerBehavior = locationTickerMessage ? 'auto' : 'animated';
const fallbackTickerSource = locationTickerMessage ? 'location' : 'default';

// Account links are placeholders until the booking/account provider is wired up.
const accountLinks = [
    { label: 'Edit Account', i18n: 'utility.editAccount', href: '#account', icon: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/>' },
    { label: 'Manage Tickets', i18n: 'utility.manageTickets', href: '#tickets', icon: '<path d="M3 9V6a1 1 0 0 1 1-1h16a1 1 0 0 1 1 1v3a3 3 0 0 0 0 6v3a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-3a3 3 0 0 0 0-6z"/><path d="M14 5v14" stroke-dasharray="2 2"/>' },
    { label: 'Rewards', i18n: 'utility.rewards', href: '#rewards', icon: '<path d="M12 3l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.4 6.8 19.1l1-5.8-4.3-4.1 5.9-.9z"/>' },
];


// Desktop mega-menu panels (hover/focus on a nav item). Images are the 480w crops already in /assets.
const megaMenus: Record<string, {
    cards: { title: string; text: string; href: string; img: string; i18n?: string }[];
    links: { label: string; href: string; i18n?: string }[];
}> = {
    '/missions': {
        cards: [
            { title: 'Magma Mayhem', text: 'Dodge the lava. Hit the targets.', href: '/missions', img: '/assets/photos/experiences/Time-Mission-Magma-Mayhem-1-480.webp' },
            { title: 'Alien Awakening', text: 'Crack the code before they wake.', href: '/missions', img: '/assets/photos/experiences/Time-Mission_Alien_Awakening-480.webp' },
            { title: 'Big Bang', text: 'Rebuild the universe, fast.', href: '/missions', img: '/assets/photos/experiences/Time-Mission_Big-Bang-480.webp' },
            { title: 'Server Heist', text: 'Slip past the lasers.', href: '/missions', img: '/assets/photos/experiences/Time-Mission_Server_Heist5-480.webp' },
        ],
        links: [
            { label: 'All 25+ missions', href: '/missions' },
            { label: 'Physical', href: '/missions?filter=physical' },
            { label: 'Mental', href: '/missions?filter=mental' },
            { label: 'Skill', href: '/missions?filter=skill' },
            { label: 'Speed', href: '/missions?filter=speed' },
        ],
    },
    '/groups': {
        cards: [
            { title: 'Birthdays', text: 'Games, cake and a crew to celebrate.', href: '/groups/birthdays', img: '/assets/photos/experiences/_Time-Mission_0321-480.webp', i18n: 'home.groups.birthdays' },
            { title: 'Corporate', text: 'Team building people actually enjoy.', href: '/groups/corporate', img: '/assets/photos/groups/corporate-events-480.webp', i18n: 'home.groups.corporate' },
            { title: 'Field Trips', text: 'Learning disguised as pure fun.', href: '/groups/field-trips', img: '/assets/photos/groups/field-trips-480.webp', i18n: 'home.groups.fieldTrips' },
            { title: 'Bachelor/ette', text: 'Make the last night out legendary.', href: '/groups/bachelor-ette', img: '/assets/photos/groups/bachelor-bachelorette-480.webp', i18n: 'home.groups.bachelor' },
        ],
        links: [
            { label: 'All groups & parties', href: '/groups' },
            { label: 'Private Events', href: '/groups/private-events', i18n: 'home.groups.privateEvents' },
            { label: 'Holidays', href: '/groups/holidays', i18n: 'home.groups.holidays' },
            { label: 'Plan an event', href: '/contact?type=event' },
        ],
    },
    '/about': {
        cards: [
            { title: 'How to Play', text: 'Team up, pick your missions, beat the clock.', href: '/about', img: '/assets/photos/venue/_Time-Mission_0024-480.webp' },
            { title: 'Locations', text: 'Find a Time Mission near you.', href: '/locations', img: '/assets/photos/venue/_Time-Mission_0042-480.webp', i18n: 'nav.locations' },
            { title: 'Gift Cards', text: 'Give the gift of adventure.', href: '/gift-cards', img: '/assets/photos/experiences/_Time-Mission_0450-480.webp', i18n: 'nav.giftCards' },
            { title: 'Blog', text: 'News, tips and new missions.', href: '/blog', img: '/assets/photos/venue/_Time-Mission_0078-480.webp' },
        ],
        links: [
            { label: 'FAQ', href: '/faq', i18n: 'nav.faq' },
            { label: 'Contact', href: '/contact', i18n: 'nav.contact' },
            { label: 'Press', href: '/press' },
            { label: 'Waiver', href: '/waiver' },
        ],
    },
};

function externalLinkAttrs(href: string | null | undefined) {
    return /^https?:\/\//i.test(String(href || '').trim())
        ? { target: '_blank', rel: 'noopener' }
        : {};
}
---

<!-- Announcement Ticker -->
{tickerMessages.length > 0 && (
    <div class="ticker-bar">
        <div
            class={`ticker-track${tickerIsStatic ? ' ticker-track--static' : ''}`}
            data-tm-ticker-source={tickerSource}
            data-tm-ticker-behavior={activeTickerBehavior}
            data-tm-ticker-starts-at={cmsAnnouncementMessage ? announcementBanner?.startsAt : undefined}
            data-tm-ticker-ends-at={cmsAnnouncementMessage ? announcementBanner?.endsAt : undefined}
            data-tm-ticker-fallback={cmsAnnouncementMessage ? fallbackTickerText : undefined}
            data-tm-ticker-fallback-i18n={cmsAnnouncementMessage ? fallbackTickerI18n : undefined}
            data-tm-ticker-fallback-behavior={cmsAnnouncementMessage ? fallbackTickerBehavior : undefined}
            data-tm-ticker-fallback-source={cmsAnnouncementMessage ? fallbackTickerSource : undefined}
        >
            {tickerMessages.map((m) => (
                <span class="ticker-item">
                    {'text' in m ? (
                        <>
                            <span data-i18n={m.textI18n}>{m.text}</span>
                            {m.href && (
                                <>
                                    <span class="ticker-separator" aria-hidden="true">-</span>
                                    <a class="ticker-link" href={m.href} data-i18n={m.linkLabelI18n} {...externalLinkAttrs(m.href)}>{m.linkLabel || 'Learn more'}</a>
                                </>
                            )}
                        </>
                    ) : (
                        <>
                            <span class="ticker-copy" data-i18n={m.labelI18n}>{m.label}</span>
                            <span class="ticker-separator" aria-hidden="true">{m.separator || '-'}</span>
                            <span class="ticker-date" data-i18n={m.dateI18n}>{m.date}</span>
                        </>
                    )}
                </span>
            ))}
        </div>
    </div>
)}

<!-- Utility Bar: current location + hours (left), language, gift cards + account (right) -->
<div class={`utility-bar${tickerMessages.length > 0 ? '' : ' utility-bar--no-ticker'}`} role="region" aria-label="Location and account" data-i18n-aria-label="utility.label">
    <div class="utility-inner">
        <div class="utility-left">
            <svg class="utility-pin" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <a class="utility-location-name" id="utilityLocationName" href="/locations" hidden></a>
            <button type="button" class="utility-choose" id="utilityChoose" data-utility-change-location data-i18n="utility.chooseLocation">Choose your location</button>
            <span class="utility-hours" id="utilityHours" hidden></span>
            <button type="button" class="utility-change" id="utilityChange" data-utility-change-location hidden><span class="utility-change-long" data-i18n="utility.changeLocation">Change location</span><span class="utility-change-short" data-i18n="utility.change">Change</span></button>
        </div>
        <div class="utility-right">
            <LanguageSwitcher currentLang={currentLang} placement="desktop" />
            <a class="utility-link" href="/gift-cards"><span class="bold-hover" data-i18n="utility.giftCards" data-label="Gift Cards">Gift Cards</span></a>
            <div class="utility-account">
                <button type="button" class="utility-account-btn" id="utilityAccountBtn" aria-haspopup="true" aria-expanded="false" aria-controls="utilityAccountMenu" aria-label="Open Mission Rewards menu" data-i18n-aria-label="utility.accountMenu">
                    <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="8" r="4"></circle>
                        <path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"></path>
                    </svg>
                    <span class="utility-account-label bold-hover" data-i18n="utility.account" data-label="Mission Rewards">Mission Rewards</span>
                    <svg class="utility-caret" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="6,9 12,15 18,9"></polyline>
                    </svg>
                </button>
                <ul class="utility-account-menu" id="utilityAccountMenu" hidden>
                    {accountLinks.map((link) => (
                        <li>
                            <a href={link.href}>
                                <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={link.icon}></svg>
                                <span data-i18n={link.i18n}>{link.label}</span>
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Navigation -->
<nav class={`nav${tickerMessages.length > 0 ? '' : ' nav--no-ticker'}`} id="nav">
    <div class="nav-left">
        <button class="nav-menu-btn" aria-label="Open menu" data-i18n-aria-label="nav.openMenu">
            <div class="hamburger">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </button>
        <a href="/" class="nav-logo">
            <img src="/assets/logo/time-mission-logo-transparent.svg" alt="Time Mission logo" width="154" height="52" />
        </a>
    </div>

    <div class="nav-center">
        <ul class="nav-links">
            {[
                { href: '/about', i18n: 'nav.about', label: 'About' },
                { href: '/missions', i18n: 'nav.missions', label: 'Missions' },
                { href: '/groups', i18n: 'nav.groups', label: 'Groups' },
                { href: '/faq', i18n: 'nav.faq', label: 'FAQ' },
            ].map((item) => {
                const mega = megaMenus[item.href];
                return (
                    <li class={mega ? 'has-mega' : undefined}>
                        <a href={item.href} data-i18n={item.i18n} data-label={item.label} aria-haspopup={mega ? 'true' : undefined}>{item.label}</a>
                        {mega && (
                            <div class="mega-panel">
                                <div class="mega-cards">
                                    {mega.cards.map((card) => (
                                        <a class="mega-card" href={card.href}>
                                            <span class="mega-card-media"><img src={card.img} alt="" width="480" height="320" loading="lazy" decoding="async" /></span>
                                            <span class="mega-card-title" data-i18n={card.i18n}>{card.title}</span>
                                            <span class="mega-card-text">{card.text}</span>
                                        </a>
                                    ))}
                                </div>
                                <ul class="mega-links">
                                    {mega.links.map((link) => (
                                        <li><a href={link.href} data-i18n={link.i18n}>{link.label}</a></li>
                                    ))}
                                </ul>
                            </div>
                        )}
                    </li>
                );
            })}
        </ul>
    </div>

    <div class="nav-right">
        <button class="location-btn" id="locationBtn" aria-label="Change location" data-i18n-aria-label="nav.changeLocation">
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span id="locationText" data-i18n="nav.selectLocation">Select Location</span>
            <svg class="location-btn-chevron" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6,9 12,15 18,9"></polyline>
            </svg>
        </button>
        <a href={bookingCtaRollerCheckout?.url || bookingCtaHref} class="btn-tickets" {...{ ...bookingCtaAttrs, 'data-i18n': undefined }}><span data-i18n="nav.book">Book</span></a>
    </div>
</nav>

<!-- Mobile: BOOK pinned across the bottom of the screen (the nav button hides on small screens) -->
<div class="mobile-book-bar">
    <a href={bookingCtaRollerCheckout?.url || bookingCtaHref} class="btn-tickets mobile-book-btn" {...{ ...bookingCtaAttrs, 'data-i18n': undefined }}><span data-i18n="nav.tickets">Tickets</span></a>
</div>
