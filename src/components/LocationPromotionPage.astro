---
import PromoSplit from './PromoSplit.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { definePage } from '../lib/define-page';
import { buildSimpleGraph, serializeGraph } from '../lib/schema/graph';

interface Props {
    bookingPresentation?: 'direct' | 'roller';
    bookingUrl: string;
    campaignLabel: string;
    ctaId: string;
    ctaLabel?: string;
    eyebrow: string;
    headlineLines: readonly [string, string];
    image?: {
        alt: string;
        position?: 'center' | 'left' | 'right';
        src: string;
        srcSet: string;
    };
    subhead?: string;
    intro?: string;
    locationName: string;
    locationSlug: string;
    offerCopy?: string;
    paragraphs?: readonly string[];
    pageSlug: string;
    promoCode?: string;
    runThrough?: string;
    disclosure?: string;
}

const {
    bookingPresentation = 'roller',
    bookingUrl,
    campaignLabel,
    ctaId,
    ctaLabel = 'Book Now',
    eyebrow,
    headlineLines,
    image = {
        alt: 'A group taking on an interactive challenge at Time Mission',
        position: 'center',
        src: '/assets/photos/TM-Groups-1200.webp',
        srcSet: '/assets/photos/TM-Groups-480.webp 480w, /assets/photos/TM-Groups-800.webp 800w, /assets/photos/TM-Groups-1200.webp 1200w, /assets/photos/TM-Groups.webp 1920w',
    },
    subhead,
    intro,
    locationName,
    locationSlug,
    offerCopy,
    paragraphs = [],
    pageSlug,
    promoCode,
    runThrough,
    disclosure,
} = Astro.props;
const bookingAttributes = bookingPresentation === 'roller'
    ? {
        'data-tm-booking-kind': 'tickets',
        'data-tm-booking-presentation': 'roller',
        'data-tm-booking-trigger': '',
        'data-tm-booking-url': bookingUrl,
    }
    : {};
const page = definePage({ canonicalPath: `/${locationSlug}/${pageSlug}` });
const ld = serializeGraph(buildSimpleGraph([
    { label: 'Home', href: '/' },
    { label: locationName, href: `/${locationSlug}` },
    { label: campaignLabel, href: page.canonicalPath },
]));
---

<SiteLayout
    canonicalPath={page.canonicalPath}
    bodyClass="has-noise tm-promo-page"
    bodyDataLocation={locationSlug}
>
    <Fragment slot="head-extra">
        <link rel="stylesheet" href="/css/page-promo.css?v=8" />
    </Fragment>
    <Fragment slot="json-ld">
        <script type="application/ld+json" is:inline set:html={ld}></script>
    </Fragment>

    <PromoSplit
        backLink={{ href: `/${locationSlug}`, label: locationName }}
        eyebrow={eyebrow}
        imageAlt={image.alt}
        imagePosition={image.position}
        imageSrc={image.src}
        imageSrcSet={image.srcSet}
    >
        <h1 id="promo-title" class="tm-promo-landing__title">
            <span>{headlineLines[0]}</span>{' '}
            <span>{headlineLines[1]}</span>
        </h1>

        <div class="tm-promo-landing__copy">
            {subhead && <p class="tm-promo-landing__subhead">{subhead}</p>}
            {intro && <p>{intro}</p>}
            {offerCopy && <p>{offerCopy}</p>}
            {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {promoCode && <p>Book with the button below or use code <strong>{promoCode}</strong>. {runThrough}</p>}
        </div>

        <div class="tm-promo-landing__rule" aria-hidden="true"></div>

        <a
            class="tm-promo-landing__cta"
            href={bookingUrl}
            {...bookingAttributes}
            data-tm-location={locationSlug}
            data-tm-promo-cta={ctaId}
        >
            {ctaLabel}
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
        </a>
        {disclosure && <p class="tm-promo-landing__terms">{disclosure}</p>}
    </PromoSplit>

    <Fragment slot="after-site-scripts">
        <script is:inline defer src="/js/page-houston-promo-after.js?v=3"></script>
    </Fragment>
</SiteLayout>
