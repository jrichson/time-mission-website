---
import { allLocations } from '../data/locations';
import { locationListLabel } from '../lib/location-list';
import { locationTeamSizeLabel } from '../lib/location-team-size';
import { ticketPanelSelectOptions } from '../lib/site-contract';
import { activeSiteProfile } from '../lib/site-profile';

interface Props {
    pageLocationSlug?: string;
}

const { pageLocationSlug = '' } = Astro.props;
const ticketOptions = ticketPanelSelectOptions(allLocations, activeSiteProfile.internalRegion);
const pageLocation = pageLocationSlug
    ? allLocations.find((loc) => loc.id === pageLocationSlug || loc.slug === pageLocationSlug)
    : null;
const playerInfoI18nKey = pageLocation?.teamSize
    ? `booking.info.players.${pageLocation.slug}`
    : 'booking.info.players';
const playerInfoText = `Teams of ${locationTeamSizeLabel(pageLocation)} players per mission`;
const briqWidget = pageLocation?.bookingProvider === 'briq' ? pageLocation.briqWidget : null;
const briqToggleState = briqWidget
    ? `bwr=bu|is|${briqWidget.domain}|and|o|is|true`
    : '';
const ticketLocations = new Map(allLocations.map((location) => [location.id, location]));

function ticketLocationI18n(value: string) {
    const location = ticketLocations.get(value);
    return location?.region === 'europe' ? `footer.location.${location.slug}` : undefined;
}

function ticketStatusI18n(label: string) {
    return /\(Coming Soon\)\s*$/.test(label) ? 'location.comingSoon' : undefined;
}

function ticketOptionBaseLabel(value: string, label: string) {
    const location = ticketLocations.get(value);
    return ticketStatusI18n(label) && location ? locationListLabel(location) : label;
}
---

<!-- Ticket Popup Panel -->
<div class="ticket-overlay" id="ticketOverlay"></div>
<div
    class="ticket-panel"
    id="ticketPanel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="ticketPanelTitle"
    aria-describedby="ticketPanelIntro"
    aria-hidden="true"
    inert
>
    <div class="ticket-panel-header">
        <h2 id="ticketPanelTitle" data-i18n="booking.title.default">Book Your Adventure</h2>
        <button class="ticket-panel-close" id="ticketClose" aria-label="Close ticket panel" data-i18n-aria-label="booking.close">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
    </div>
    <div class="ticket-panel-content">
        <div data-ticket-panel-standard>
            <p id="ticketPanelIntro" data-i18n="booking.intro.default">Select your location and we'll take you to our booking system to choose your date and time.</p>

            <div class="ticket-location-select">
                <label for="ticketLocation" data-i18n="booking.locationLabel">Choose Location</label>
                <select id="ticketLocation">
                    <option value="" data-i18n="booking.locationPlaceholder">Select a location</option>
                    {ticketOptions.map((opt) => {
                        const statusI18n = ticketStatusI18n(opt.label);
                        return (
                            <option
                                value={opt.value}
                                data-i18n={ticketLocationI18n(opt.value)}
                                data-i18n-status={statusI18n}
                            >
                                {ticketOptionBaseLabel(opt.value, opt.label)}{statusI18n ? ' (Coming Soon)' : ''}
                            </option>
                        );
                    })}
                </select>
            </div>

            <a href="#" class="btn-ticket-book" id="ticketBookBtn">
                <span id="ticketBookBtnText" data-i18n="booking.cta.default">Continue to Booking</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M12 5l7 7-7 7"></path>
                </svg>
            </a>

            <div class="ticket-panel-info">
                <h3 data-i18n="booking.quickInfo">QUICK INFO</h3>
                <div class="ticket-info-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M12 6v6l4 2"></path>
                    </svg>
                    <span data-i18n="booking.info.sessions">Sessions last approximately 60-120 minutes</span>
                </div>
                <div class="ticket-info-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                    <span id="ticketPlayersInfo" data-i18n={playerInfoI18nKey}>{playerInfoText}</span>
                </div>
                <div class="ticket-info-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    <span data-i18n="booking.info.advance">Advance booking recommended</span>
                </div>
            </div>
        </div>

        {briqWidget && (
            <div id="briq-widget-container" class="briq-panel-widget" data-briq-panel-widget>
                <div class="briq-widget-loader" data-briq-widget-loader role="status" aria-live="polite">
                    <span class="briq-widget-spinner" aria-hidden="true"></span>
                    <span class="briq-widget-loader-title">Loading booking options</span>
                </div>
                <button
                    type="button"
                    class="bw-widget-toggle briq-widget-toggle-proxy"
                    data-widget-state={briqToggleState}
                    data-briq-open-toggle
                    aria-hidden="true"
                    tabindex="-1"
                >
                    Open booking
                </button>
                <div
                    id="briq-widget"
                    class="bw-widget"
                    data-domain={briqWidget.domain}
                    data-color-1-base={briqWidget.color1Base}
                    data-color-1-contrast={briqWidget.color1Contrast}
                    data-color-2-base={briqWidget.color2Base}
                    data-color-2-contrast={briqWidget.color2Contrast}
                    data-price-display={briqWidget.priceDisplay}
                    data-button-text={briqWidget.buttonText}
                    data-features="hideMainButton"
                    data-positioning="[{'x-align':'right','x-offset':'0px','y-offset':'0px','z-index':'10000'}]"
                ></div>
            </div>
        )}
    </div>
</div>
