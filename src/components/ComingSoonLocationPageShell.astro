---
import ComingSoonLocationPage from './ComingSoonLocationPage.astro';
import LocationPageHeadLinks from './LocationPageHeadLinks.astro';
import PageWidgetsScripts from './PageWidgetsScripts.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { locationPageCssHref, locationPageLang } from '../lib/location-page-registry';
import { activeSiteProfile } from '../lib/site-profile';

interface Props {
    cityPage: {
        cta: {
            href: string;
            i18n: string;
            isBookingTrigger: boolean;
            label: string;
            signupFormId?: string;
        };
        ld: string;
        location: { slug: string };
        page: { canonicalPath: string };
        pageDescription: string;
        pageInit: unknown;
        pageTitle: string;
    };
}

const { cityPage } = Astro.props;
const slug = cityPage.location.slug;
const lang = activeSiteProfile.localizedRoutes
    ? activeSiteProfile.defaultLocale
    : locationPageLang(slug);
const pageCss = locationPageCssHref(slug);
---

<SiteLayout
    canonicalPath={cityPage.page.canonicalPath}
    title={cityPage.pageTitle}
    description={cityPage.pageDescription}
    lang={lang}
    bodyDataLocation={cityPage.location.slug}
    bookingCtaHref={cityPage.cta.href}
    bookingCtaLabel={cityPage.cta.label}
    bookingCtaIsBookingTrigger={cityPage.cta.isBookingTrigger}
    bookingCtaI18n={cityPage.cta.i18n}
    bookingCtaSignupFormId={cityPage.cta.signupFormId}
>
    <Fragment slot="head-extra">
        <LocationPageHeadLinks pageCss={pageCss} />
    </Fragment>
    <Fragment slot="json-ld">
        <script type="application/ld+json" is:inline set:html={cityPage.ld}></script>
    </Fragment>
    <ComingSoonLocationPage slug={slug} />
    <Fragment slot="after-site-scripts">
        <PageWidgetsScripts pageInit={cityPage.pageInit} />
    </Fragment>
</SiteLayout>
