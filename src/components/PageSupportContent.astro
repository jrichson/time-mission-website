---
import type { LocationRecord } from '../data/locations';
import { hasTicketBooking, locationDisplayStatus } from '../lib/location-status';
import { locationAddressText, locationMarket } from '../lib/location-view';

interface Props {
    canonicalPath: string;
    pageLocation?: LocationRecord | null;
}

interface SupportCard {
    title: string;
    body: string;
}

interface SupportLink {
    href: string;
    label: string;
}

interface SupportContent {
    eyebrow: string;
    title: string;
    intro: string;
    cards: SupportCard[];
    details: string[];
    links: SupportLink[];
}

const { canonicalPath, pageLocation = null } = Astro.props;

function buildLocationContent(location: LocationRecord): SupportContent {
    const market = locationMarket(location);
    const address = locationAddressText(location);
    const status = locationDisplayStatus(location);
    const bookingCopy = hasTicketBooking(location)
        ? `Tickets for ${location.shortName} can be reserved online, so teams can choose a date, compare available times, and arrive with the waiver step already handled.`
        : `${location.shortName} is listed as ${status}. This page will stay focused on opening details, launch timing, and the best way to reach the local team while booking is not fully live.`;

    return {
        eyebrow: 'Plan your mission',
        title: `Useful Details for Time Mission ${location.shortName}`,
        intro: `Time Mission ${location.shortName} is part of a social gaming adventure built around short, physical, and puzzle-driven challenge rooms. The local page is the best place to confirm booking status, location details, and what to expect before gathering a team.`,
        cards: [
            {
                title: 'Mission Format',
                body: `A visit is built for teams that want more than a single escape room. Players move through a collection of interactive rooms, earn points together, and can rotate through challenges that reward communication, timing, memory, movement, and creative problem solving.`,
            },
            {
                title: 'Booking Readiness',
                body: bookingCopy,
            },
            {
                title: 'Groups and Events',
                body: `The ${market || location.shortName} location is designed for families, date nights, birthdays, corporate groups, field trips, and other repeatable group outings. Larger parties can use the groups and contact pages to ask about timing, private events, and planning help.`,
            },
            {
                title: 'Local Details',
                body: address
                    ? `${location.shortName} is listed at ${address}. Use the local page for directions, phone and email details, hours, waiver routing, and the current booking path before heading out.`
                    : `Use the local page for directions, phone and email details, hours, waiver routing, and the current booking path before heading out.`,
            },
        ],
        details: [
            `${location.shortName} is the central planning page for this market. It connects the venue address, booking status, waiver guidance, group-event path, and contact route in one place so guests can understand how this location fits into the broader Time Mission experience.`,
            `For planning, start with this local page, then move to the mission overview, group-event details, or waiver page depending on the visit. Those paths help people compare locations, understand the activity, and complete pre-visit steps before gathering their team.`,
        ],
        links: [
            { href: '/', label: 'Time Mission Home' },
            { href: '/locations', label: 'All Locations' },
            { href: '/missions', label: 'The Missions' },
            { href: '/groups', label: 'Group Events' },
            { href: '/waiver', label: 'Waiver' },
        ],
    };
}

const routeContent: Record<string, SupportContent> = {
    '/': {
        eyebrow: 'What to expect',
        title: 'A Mission-Based Game Built for Real Groups',
        intro: 'Time Mission combines the energy of an arcade, the teamwork of an escape room, and the variety of a game show into one repeatable experience. The site now gives crawlers and visitors a clearer overview of how the experience works before they choose a location.',
        cards: [
            {
                title: 'Many Rooms, One Score',
                body: 'Instead of booking one fixed scenario, teams move through a large set of short mission rooms. Each room tests a different mix of coordination, speed, logic, observation, and communication, then rolls those attempts into an overall team score.',
            },
            {
                title: 'Built for Repeat Visits',
                body: 'Because the challenges are modular, groups can return with new teammates, chase a better score, or try rooms they missed the first time. That makes Time Mission useful for casual outings and organized events alike.',
            },
            {
                title: 'Location-First Planning',
                body: 'Each local page carries the current booking status, hours, address, directions, and contact details for that market. Visitors should start with the nearest location to confirm availability before planning a visit.',
            },
            {
                title: 'Events Beyond Tickets',
                body: 'Birthdays, field trips, company outings, bachelor and bachelorette groups, and private events can use the group pages to compare event types and send the right planning request to the Time Mission team.',
            },
        ],
        details: [
            'For guests comparing activities, the important distinction is that Time Mission is not a passive arcade stop or a single-room escape game. It is a location-based team challenge where the route, score, and room mix can vary by visit, which gives guests a clear reason to choose a market page, review missions, and book ahead.',
            'The homepage links the major planning paths together: locations for practical details, missions for the experience format, groups for event planning, gift cards for flexible gifting, and waiver information for pre-arrival readiness. Those routes help visitors understand the site as one connected experience.',
        ],
        links: [
            { href: '/locations', label: 'Browse Locations' },
            { href: '/missions', label: 'Explore Missions' },
            { href: '/groups', label: 'Plan a Group Event' },
            { href: '/gift-cards', label: 'Gift Cards' },
        ],
    },
    '/about': {
        eyebrow: 'About the experience',
        title: 'How Time Mission Turns a Visit Into a Team Challenge',
        intro: 'Time Mission is designed around active play, shared problem solving, and fast feedback. The format gives families, friends, coworkers, and students a flexible way to compete together without needing the same skill level or a long rule explanation.',
        cards: [
            {
                title: 'Short Challenge Rooms',
                body: 'Rooms are intentionally compact, so the pace stays high and teams can recover quickly after a missed attempt. A group can test memory in one room, movement in another, and coordination in the next without committing the whole visit to one puzzle style.',
            },
            {
                title: 'Team Scoring',
                body: 'The shared score gives every player a reason to contribute. Some rooms reward speed, others reward precision, and others reward communication, which helps mixed-age and mixed-ability groups find moments where different players can lead.',
            },
            {
                title: 'Local Operations',
                body: 'Each venue has its own booking status, hours, waiver flow, and event capacity. The location pages and contact page are structured to route guests to the right local information before they arrive.',
            },
            {
                title: 'Event Flexibility',
                body: 'The same format can support a quick weekend outing, a birthday party, a school trip, or a corporate team event. Group pages explain the main event types and help visitors move from general interest to a specific planning request.',
            },
        ],
        details: [
            'The about page is meant to explain why Time Mission works for different kinds of groups. The experience is physical enough to feel active, varied enough for repeat visits, and structured enough for guests to understand the goal quickly once they arrive.',
            'From here, visitors can move naturally into the mission overview, nearby locations, group-event planning, or the homepage. Those links reinforce the relationship between the brand story and the practical pages where people choose a venue, check booking status, and prepare for a visit.',
        ],
        links: [
            { href: '/', label: 'Time Mission Home' },
            { href: '/missions', label: 'The Missions' },
            { href: '/locations', label: 'Locations' },
            { href: '/groups', label: 'Groups' },
        ],
    },
    '/contact': {
        eyebrow: 'Contact routing',
        title: 'Reach the Right Time Mission Team',
        intro: 'The contact page supports general questions, location updates, event planning, and booking help. Choosing the closest location and the right request type helps the message get routed to the team that can answer with current local details.',
        cards: [
            {
                title: 'Location Questions',
                body: 'Guests can ask about hours, directions, opening timing, accessibility, or local booking availability. Location-specific questions are routed with the selected market so the response can reflect the right venue.',
            },
            {
                title: 'Events and Groups',
                body: 'Birthday parties, corporate events, field trips, holidays, private events, and bachelor or bachelorette outings often need details beyond standard tickets. The form gives those requests a clear path into the planning conversation.',
            },
            {
                title: 'Waivers and Booking',
                body: 'If a guest needs help with a waiver, ticket checkout, gift card, or booking provider, the contact page can capture the location and request type before a team member follows up.',
            },
            {
                title: 'Opening Updates',
                body: 'Coming-soon markets use contact routing for launch interest and local updates. That keeps visitors connected without creating duplicate location pages or crawlable query-string URLs for the same contact content.',
            },
        ],
        details: [
            'The contact page should stay focused on routing rather than duplicating every location page. Location and request-type context allows Time Mission to answer practical questions about opening dates, event planning, waivers, tickets, and local availability without making guests repeat the same details.',
            'Visitors who are still deciding should start from the homepage or locations page, then return here when they have a specific question. That keeps the information architecture clear for guests and keeps contact as a support path, not a replacement for location content.',
        ],
        links: [
            { href: '/', label: 'Time Mission Home' },
            { href: '/locations', label: 'Locations' },
            { href: '/groups', label: 'Group Events' },
            { href: '/faq', label: 'FAQ' },
        ],
    },
    '/gift-cards': {
        eyebrow: 'Gift planning',
        title: 'Gift Cards for Mission-Based Play',
        intro: 'A Time Mission gift card works best when the recipient can choose the date, location, and team they want to bring. This page gives visitors a clearer path from gift interest to the location and booking details that make the gift usable.',
        cards: [
            {
                title: 'Flexible Outings',
                body: 'Gift cards are useful for birthdays, holidays, thank-you gifts, family activities, and date-night ideas because the recipient can turn the gift into a shared experience instead of a single product.',
            },
            {
                title: 'Choose a Location',
                body: 'Availability and redemption details can vary by venue, so visitors should check the recipient’s nearest Time Mission location before finalizing plans. Local pages carry the current booking status and contact details.',
            },
            {
                title: 'Pair With a Group',
                body: 'A gift card can become the starting point for a larger outing. Families, friend groups, and coworkers can use the group pages to compare event types and decide whether standard tickets or a planned event makes more sense.',
            },
            {
                title: 'Before the Visit',
                body: 'Players should review waiver requirements, confirm the location, and book ahead when online booking is available. Those steps help the gift turn into a smoother first visit.',
            },
        ],
        details: [
            'Gift-card buyers often need enough context to know that the gift will be useful, but they may not know which date or group the recipient will choose. The supporting links point them toward locations, waiver guidance, contact help, and the homepage so the gift can turn into a complete visit.',
            'This page also supports non-ticket planning moments: holiday gifts, family activities, employee recognition, and group outings where the buyer wants to give an experience without managing every booking detail upfront.',
        ],
        links: [
            { href: '/', label: 'Time Mission Home' },
            { href: '/locations', label: 'Locations' },
            { href: '/waiver', label: 'Waiver' },
            { href: '/contact', label: 'Contact' },
        ],
    },
    '/waiver': {
        eyebrow: 'Before you play',
        title: 'Waiver Guidance for Time Mission Visits',
        intro: 'The waiver page helps guests get the required paperwork out of the way before arrival. This page gives visitors a direct answer for an important pre-visit step.',
        cards: [
            {
                title: 'Who Needs a Waiver',
                body: 'Everyone entering the portal area needs a completed waiver on file. For guests under 18, a parent or legal guardian must complete the waiver before play.',
            },
            {
                title: 'Location Routing',
                body: 'Waiver providers can vary by location. Selecting the correct location helps guests reach the right waiver destination instead of guessing from a general link.',
            },
            {
                title: 'Booking Connection',
                body: 'Completing the waiver is separate from choosing a time, but doing both before arrival keeps check-in moving. Guests should confirm their location page for current booking status.',
            },
            {
                title: 'Help With Waivers',
                body: 'If a waiver link does not match the intended location or a guest is unsure which form to use, the contact page can route the question to the right local team.',
            },
        ],
        details: [
            'The waiver page belongs in the main public planning flow because it answers a common pre-visit question. It stays connected to the homepage, locations, FAQ, and contact page so guests can find the right form without needing to search from scratch.',
            'Instead of scattering waiver explanations across location pages, this page can hold the general requirement while local pages and booking flows handle venue-specific routing. That makes the next step clearer for guests before they arrive.',
        ],
        links: [
            { href: '/', label: 'Time Mission Home' },
            { href: '/locations', label: 'Locations' },
            { href: '/contact', label: 'Contact' },
            { href: '/faq', label: 'FAQ' },
        ],
    },
};

const content = pageLocation ? buildLocationContent(pageLocation) : routeContent[canonicalPath] ?? null;
---

{content ? (
    <section class="page-support" aria-labelledby="page-support-title">
        <div class="page-support__inner">
            <p class="page-support__eyebrow">{content.eyebrow}</p>
            <div class="page-support__heading">
                <h2 id="page-support-title">{content.title}</h2>
                <p>{content.intro}</p>
            </div>
            <div class="page-support__grid">
                {content.cards.map((card) => (
                    <article class="page-support__item">
                        <h3>{card.title}</h3>
                        <p>{card.body}</p>
                    </article>
                ))}
            </div>
            <div class="page-support__details">
                {content.details.map((detail) => <p>{detail}</p>)}
            </div>
            <nav class="page-support__links" aria-label="Related Time Mission pages">
                {content.links.map((link) => (
                    <a href={link.href}>{link.label}</a>
                ))}
            </nav>
        </div>
    </section>
) : null}
