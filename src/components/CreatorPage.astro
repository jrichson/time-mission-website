---
import KlaviyoEmbedForm from './KlaviyoEmbedForm.astro';
import PromoSplit from './PromoSplit.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { definePage } from '../lib/define-page';
import { buildSimpleGraph, serializeGraph } from '../lib/schema/graph';

interface Props {
    // Omit for the all-locations /creators page.
    location?: {
        name: string;
        slug: string;
        // The location's value in the form's "Closest Time Mission location" dropdown.
        formValue: string;
    };
}

const { location } = Astro.props;
const formId = 'WKi36B';
const page = definePage({ canonicalPath: location ? `/${location.slug}/creators` : '/creators' });
const ld = serializeGraph(buildSimpleGraph([
    { label: 'Home', href: '/' },
    ...(location ? [{ label: location.name, href: `/${location.slug}` }] : []),
    { label: 'Creator Program', href: page.canonicalPath },
]));
const venue = location ? `Time Mission ${location.name}` : 'Time Mission';
---

<SiteLayout
    canonicalPath={page.canonicalPath}
    bodyClass="has-noise tm-promo-page tm-creator-page"
    bodyDataLocation={location?.slug}
>
    <Fragment slot="head-extra">
        <link rel="stylesheet" href="/css/page-promo.css?v=7" />
    </Fragment>
    <Fragment slot="json-ld">
        <script type="application/ld+json" is:inline set:html={ld}></script>
    </Fragment>

    <PromoSplit
        backLink={location ? { href: `/${location.slug}`, label: location.name } : { href: '/', label: 'Home' }}
        eyebrow={location ? `${location.name} · Creator Program` : 'Creator Program'}
        imageAlt="A creator films two guests with microphones in the mission hallway at Time Mission"
        imagePosition="center"
        imageSrc="/assets/photos/promos/creators-filming-1200.webp"
        imageSrcSet="/assets/photos/promos/creators-filming-480.webp 480w, /assets/photos/promos/creators-filming-800.webp 800w, /assets/photos/promos/creators-filming-1200.webp 1200w, /assets/photos/promos/creators-filming-1600.webp 1600w"
    >
        <h1 id="promo-title" class="tm-promo-landing__title tm-promo-landing__title--creators">
            <span>Time Mission</span>{' '}
            <span>Creator Program</span>
        </h1>

        <div class="tm-promo-landing__copy">
            <p>From brain-bending puzzles to full-body challenges, every mission at {venue} brings a different kind of rush. No headsets, no controllers, and something worth filming in every room.</p>
        </div>

        <section class="tm-promo-form tm-promo-form--live" aria-label="Creator Program application">
            <KlaviyoEmbedForm
                formId={formId}
                formName="creator_program"
                backupDefaults={location ? { creator_location: location.formValue } : {}}
            />
        </section>
    </PromoSplit>
</SiteLayout>
