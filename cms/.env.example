# Required
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE
PAYLOAD_SECRET=min-32-character-random-secret-for-jwt
PAYLOAD_SERVER_URL=http://localhost:3000
CMS_OWNER_EMAIL=owner@example.com

# Required for CMS user invite delivery; password resets otherwise use Payload's console adapter
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey-or-username
# SMTP_PASS=secret
# SMTP_FROM_ADDRESS=noreply@timemission.com
# SMTP_FROM_NAME=Time Mission CMS
# SMTP_SECURE=false
# SMTP_SKIP_VERIFY=false

# Optional: comma-separated origin allowlist for browser clients that need CMS API access
# PAYLOAD_ALLOWED_ORIGINS=http://localhost:4321,https://timemission.com

# Optional: public Astro/Cloudflare origin used by CMS previews for /assets/... image URLs
# PAYLOAD_PUBLIC_SITE_ORIGIN=https://timemission.com

# Optional: production DB schema pushes are off unless explicitly enabled
# PAYLOAD_DB_PUSH=false

# Optional: GraphQL is disabled by default; REST is used by the public site build
# PAYLOAD_ENABLE_GRAPHQL=false

# Optional future automation: trigger production rebuild when published landings change.
# Leave unset for Wrangler Direct Upload unless you add separate CI/direct-upload automation.
# CMS deploy button. Use GitHub Actions for Wrangler Direct Upload deploys.
# CMS_DEPLOY_PROVIDER=github_actions
# GITHUB_ACTIONS_DEPLOY_TOKEN=github_pat_...
# GITHUB_ACTIONS_DEPLOY_REPO=jrichson/time-mission-website
# GITHUB_ACTIONS_DEPLOY_WORKFLOW_ID=cms-wrangler-deploy.yml
# GITHUB_ACTIONS_DEPLOY_REF=rebuild
#
# Optional older path for Cloudflare Pages Git deploy hooks. Do not use this for Wrangler-only deploys.
# CLOUDFLARE_PAGES_DEPLOY_HOOK_URL=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/...
